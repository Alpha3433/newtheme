          "settings": {
            "symptom_title": "Near-Infrared Light (850nm)",
            "symptom_description": "<p>The deepest penetrating wavelength that promotes healing, reduces inflammation, and improves skin tone. This is what gives you that enviable glow.</p>",
            "symptom_science_text": "<p>Near-infrared light reduces inflammation markers and accelerates skin repair at the cellular level.</p>",
