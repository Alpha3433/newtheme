        "icon_bullet_list_ygxh4r": {
          "type": "icon_bullet_list",
          "settings": {
            "list_content": "<ul><li>FREE protective storage case ($39 value)</li><li>FREE shipping anywhere in the US</li><li>Complete user guide with treatment protocols</li><li>90-day money-back guarantee</li><li>2-year manufacturer warranty</li></ul>",
            "icon_size": 20,
