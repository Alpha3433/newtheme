        "article_heading_9Nprhh": {
          "type": "article_heading",
          "settings": {
            "heading_text": "<p><strong>How Do You Use It?</strong></p>",
            "highlight_text": "",
            "heading_font_size": 36,
            "heading_line_height": 1.2,
            "text_color": "#000000",
            "highlight_color": "#000000",
            "text_alignment": "left",
