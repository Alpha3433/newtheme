          "type": "faq_item",
          "settings": {
            "question": "Are there any side effects?",
            "answer": "<p>None reported. Pumpkin seed oil and caffeine are both well-studied natural compounds with no known side effects when applied topically. If you have a sensitive scalp do a small patch test before full application.</p>"
          }
        },
