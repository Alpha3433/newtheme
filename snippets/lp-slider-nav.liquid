{%- comment -%} Prev / dots / next controls for an lp horizontal slider. Params: count {%- endcomment -%}
<div class="lp-nav" data-lp-nav>
  <button type="button" class="lp-nav__btn" data-lp-prev aria-label="Previous"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 6 9 12 15 18"/></svg></button>
  <div class="lp-nav__dots">
    {%- for i in (1..count) -%}<button type="button" class="lp-nav__dot{% if forloop.first %} is-active{% endif %}" data-lp-dot aria-label="Go to {{ i }}"></button>{%- endfor -%}
  </div>
  <button type="button" class="lp-nav__btn" data-lp-next aria-label="Next"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"/></svg></button>
</div>
