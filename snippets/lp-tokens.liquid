{%- comment -%}
  lp-tokens: shared design tokens for the "lp-" landing-page sections.

  Every colour is derived from Theme settings so the sections always follow the
  store palette. The reference layout used a navy/blue system; here the roles are:
    --lp-ink      headings, dark bands, primary text   <- global_section_text_color
    --lp-accent   pills, icons, active states          <- button_gradient_start (fallback accent 1)
    --lp-tints    light bands / option banners         <- accent mixed with white
    --lp-cta      add-to-cart button                   <- global button gradient / colour
    --lp-sale     save pills, strike-through prices    <- global_section_accent_1_color
  Rendered by each lp- section; the rules are idempotent so duplicates are harmless.
{%- endcomment -%}
{%- liquid
  assign lp_ink = settings.global_section_text_color | default: '#282828'
  assign lp_bg = settings.global_section_background_color | default: '#ffffff'
  assign lp_accent = settings.button_gradient_start | default: settings.global_section_accent_1_color | default: '#fb7948'
  assign lp_accent_2 = settings.button_gradient_end | default: lp_accent
  assign lp_sale = settings.global_section_accent_1_color | default: '#d93c55'
  assign lp_cta_text = settings.global_button_text_color_primary | default: '#ffffff'
  if settings.enable_button_gradient
    assign lp_cta_bg = 'linear-gradient(135deg, ' | append: lp_accent | append: ' 0%, ' | append: lp_accent_2 | append: ' 100%)'
  else
    assign lp_cta_bg = settings.global_button_background_color | default: lp_accent
  endif
  assign lp_cta_hover = settings.global_button_hover_bg_color | default: lp_ink
-%}
<style>
  :root {
    --lp-ink: {{ lp_ink }};
    --lp-ink-2: {{ lp_ink | color_mix: '#ffffff', 74 }};
    --lp-muted: {{ lp_ink | color_mix: '#ffffff', 52 }};
    --lp-faint: {{ lp_ink | color_mix: '#ffffff', 38 }};
    --lp-line: {{ lp_ink | color_mix: '#ffffff', 9 }};
    --lp-line-2: {{ lp_ink | color_mix: '#ffffff', 5 }};
    --lp-bg: {{ lp_bg }};
    --lp-bg-soft: {{ lp_ink | color_mix: lp_bg, 3 }};
    --lp-bg-warm: {{ lp_accent | color_mix: lp_bg, 4 }};
    --lp-accent: {{ lp_accent }};
    --lp-accent-2: {{ lp_accent_2 }};
    --lp-accent-dark: {{ lp_accent | color_mix: '#000000', 78 }};
    --lp-accent-rgb: {{ lp_accent | color_extract: 'red' }}, {{ lp_accent | color_extract: 'green' }}, {{ lp_accent | color_extract: 'blue' }};
    --lp-ink-rgb: {{ lp_ink | color_extract: 'red' }}, {{ lp_ink | color_extract: 'green' }}, {{ lp_ink | color_extract: 'blue' }};
    --lp-tint-1: {{ lp_accent | color_mix: '#ffffff', 16 }};
    --lp-tint-2: {{ lp_accent | color_mix: '#ffffff', 26 }};
    --lp-tint-3: {{ lp_accent | color_mix: '#ffffff', 8 }};
    --lp-tint-4: {{ lp_accent | color_mix: '#ffffff', 5 }};
    --lp-tint-line: {{ lp_accent | color_mix: '#ffffff', 22 }};
    --lp-band: linear-gradient(135deg, {{ lp_accent | color_mix: '#ffffff', 16 }} 0%, {{ lp_accent | color_mix: '#ffffff', 26 }} 50%, {{ lp_accent | color_mix: '#ffffff', 16 }} 100%);
    --lp-band-soft: linear-gradient(180deg, {{ lp_accent | color_mix: '#ffffff', 8 }} 0%, {{ lp_accent | color_mix: '#ffffff', 16 }} 100%);
    --lp-sale: {{ lp_sale }};
    --lp-star: {{ lp_sale }};
    --lp-cta-bg: {{ lp_cta_bg }};
    --lp-cta-text: {{ lp_cta_text }};
    --lp-cta-hover: {{ lp_cta_hover }};
    --lp-font-body: var(--font-body-family, inherit);
    --lp-font-heading: var(--font-heading-family, var(--font-body-family, inherit));
    --lp-radius: 14px;
  }
  .lp * { box-sizing: border-box; min-width: 0; }
  .lp img { max-width: 100%; display: block; }
  .lp { font-family: var(--lp-font-body); color: var(--lp-ink); -webkit-font-smoothing: antialiased; }
  .lp h1, .lp h2, .lp h3, .lp h4 { font-family: var(--lp-font-heading); }
  .lp p { margin: 0; }
  .lp button { font-family: inherit; }
  .lp-pill { display: inline-flex; align-items: center; gap: 7px; font-size: 10.5px; font-weight: 800; color: var(--lp-accent-dark); letter-spacing: 1.6px; text-transform: uppercase; padding: 7px 14px; background: rgba(var(--lp-accent-rgb), .10); border: 1px solid rgba(var(--lp-accent-rgb), .30); border-radius: 999px; margin: 0 0 14px; line-height: 1; }
  .lp-pill svg { width: 12px; height: 12px; color: var(--lp-accent-dark); flex-shrink: 0; display: block; }
  .lp-cta { display: inline-flex; align-items: center; justify-content: center; gap: 10px; padding: 16px 28px; background: var(--lp-cta-bg); color: var(--lp-cta-text); border: 0; border-radius: 10px; cursor: pointer; font-family: inherit; font-size: 13px; font-weight: 800; letter-spacing: 1.2px; text-transform: uppercase; line-height: 1; text-decoration: none; transition: filter .15s ease, transform .1s ease; }
  .lp-cta:hover { filter: brightness(.94); color: var(--lp-cta-text); }
  .lp-cta:active { transform: scale(.98); }
  .lp-cta svg { width: 14px; height: 14px; }
  @media (max-width: 480px) { .lp-cta { padding: 14px 22px; font-size: 12px; letter-spacing: 1px; } }
</style>
