{%- render 'lp-tokens' -%}
{%- liquid
  assign s = section.settings
  assign rows = section.blocks | where: 'type', 'row'
-%}
<section class="lp lp-vs" id="lp-vs-{{ section.id }}">
  <div class="lp-vs__inner">
    <div class="lp-vs__head">
      {%- if s.kicker != blank -%}<div class="lp-pill"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19h16M6 15V9M12 15V5M18 15v-4"/></svg>{{ s.kicker | escape }}</div>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="lp-vs__h">{{ s.heading | escape }}</h2>{%- endif -%}
      {%- if s.subheading != blank -%}<div class="lp-vs__sub">{{ s.subheading }}</div>{%- endif -%}
    </div>
    {%- if rows.size > 0 -%}
      <div class="lp-vs__table">
        <div class="lp-vs__row lp-vs__row--head">
          <div class="lp-vs__col-empty"></div>
          <div class="lp-vs__col-head lp-vs__col-head--us">{{ s.us_label | escape }}</div>
          <div class="lp-vs__col-head">{{ s.them_label | escape }}</div>
        </div>
        {%- for block in rows -%}
          <div class="lp-vs__row" {{ block.shopify_attributes }}>
            <div class="lp-vs__label">{{ block.settings.label | escape }}</div>
            <div class="lp-vs__val lp-vs__val--us">
              {%- case block.settings.us_type -%}
                {%- when 'yes' -%}<svg class="lp-vs__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-label="Yes"><polyline points="20 6 9 17 4 12"/></svg>
                {%- when 'no' -%}<svg class="lp-vs__icon lp-vs__icon--no" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-label="No"><path d="M6 6l12 12M18 6L6 18"/></svg>
                {%- else -%}{{ block.settings.us_text | escape }}
              {%- endcase -%}
            </div>
            <div class="lp-vs__val lp-vs__val--them">
              {%- case block.settings.them_type -%}
                {%- when 'yes' -%}<svg class="lp-vs__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-label="Yes"><polyline points="20 6 9 17 4 12"/></svg>
                {%- when 'no' -%}<svg class="lp-vs__icon lp-vs__icon--no" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-label="No"><path d="M6 6l12 12M18 6L6 18"/></svg>
                {%- else -%}{{ block.settings.them_text | escape }}
              {%- endcase -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
    {%- if s.closing != blank -%}<div class="lp-vs__close">{{ s.closing }}</div>{%- endif -%}
    {%- if s.cta_label != blank -%}<div class="lp-vs__cta-wrap"><a class="lp-cta" href="{{ s.cta_link | default: '#plan-selector' }}" data-lp-vs-cta>{{ s.cta_label | escape }}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 6 15 12 9 18"/></svg></a></div>{%- endif -%}
  </div>
</section>
{% style %}
  #lp-vs-{{ section.id }} { background: var(--lp-bg); padding: 48px 16px 56px; border-top: 1px solid var(--lp-line); }
  #lp-vs-{{ section.id }} .lp-vs__inner { max-width: 840px; margin: 0 auto; }
  #lp-vs-{{ section.id }} .lp-vs__head { text-align: center; margin: 0 0 28px; }
  #lp-vs-{{ section.id }} .lp-vs__h { font-size: 24px; font-weight: 800; line-height: 1.25; color: var(--lp-ink); letter-spacing: -.02em; margin: 0 0 14px; text-wrap: balance; text-transform: none; }
  #lp-vs-{{ section.id }} .lp-vs__sub { font-size: 14px; line-height: 1.7; color: var(--lp-ink-2); margin: 0 auto; max-width: 60ch; }
  #lp-vs-{{ section.id }} .lp-vs__table { margin: 18px 0 0; border: 1px solid var(--lp-tint-line); border-radius: 14px; overflow: hidden; background: #fff; box-shadow: 0 4px 16px rgba(var(--lp-ink-rgb), .06); }
  #lp-vs-{{ section.id }} .lp-vs__row { display: grid; grid-template-columns: 115px 1fr 1fr; border-bottom: 1px solid rgba(var(--lp-ink-rgb), .07); }
  #lp-vs-{{ section.id }} .lp-vs__row:last-child { border-bottom: none; }
  #lp-vs-{{ section.id }} .lp-vs__row--head, #lp-vs-{{ section.id }} .lp-vs__col-empty { background: var(--lp-ink); }
  #lp-vs-{{ section.id }} .lp-vs__col-head { padding: 13px 10px; font-size: 10.5px; font-weight: 800; letter-spacing: .6px; text-transform: uppercase; color: #fff; text-align: center; line-height: 1.25; display: flex; align-items: center; justify-content: center; }
  #lp-vs-{{ section.id }} .lp-vs__col-head--us { background: var(--lp-accent); }
  #lp-vs-{{ section.id }} .lp-vs__label { padding: 14px 12px; font-size: 11.5px; font-weight: 700; color: var(--lp-ink); background: var(--lp-bg-warm); display: flex; align-items: center; line-height: 1.35; }
  #lp-vs-{{ section.id }} .lp-vs__val { padding: 14px 10px; font-size: 12.5px; line-height: 1.45; display: flex; align-items: center; justify-content: center; text-align: center; }
  #lp-vs-{{ section.id }} .lp-vs__val--us { color: var(--lp-accent-dark); font-weight: 800; background: rgba(var(--lp-accent-rgb), .07); }
  #lp-vs-{{ section.id }} .lp-vs__val--them { color: var(--lp-muted); font-weight: 500; }
  #lp-vs-{{ section.id }} .lp-vs__icon { width: 20px; height: 20px; }
  #lp-vs-{{ section.id }} .lp-vs__icon--no { color: var(--lp-faint); }
  #lp-vs-{{ section.id }} .lp-vs__close { margin: 24px 0 0; padding: 20px 22px; background: linear-gradient(160deg, var(--lp-bg-warm) 0%, var(--lp-tint-4) 100%); border: 1px solid rgba(var(--lp-ink-rgb), .10); border-radius: 14px; font-size: 14px; line-height: 1.65; color: var(--lp-ink-2); }
  #lp-vs-{{ section.id }} .lp-vs__close p { margin: 0 0 10px; } #lp-vs-{{ section.id }} .lp-vs__close p:last-child { margin: 0; }
  #lp-vs-{{ section.id }} .lp-vs__close strong { font-weight: 700; color: var(--lp-ink); }
  #lp-vs-{{ section.id }} .lp-vs__close p:first-child { font-size: 15px; font-style: italic; color: var(--lp-ink); font-weight: 600; }
  #lp-vs-{{ section.id }} .lp-vs__cta-wrap { margin: 28px 0 0; text-align: center; }
  @media (max-width: 480px) { #lp-vs-{{ section.id }} { padding: 40px 14px 48px; } #lp-vs-{{ section.id }} .lp-vs__h { font-size: 20px; } #lp-vs-{{ section.id }} .lp-vs__row { grid-template-columns: 96px 1fr 1fr; } #lp-vs-{{ section.id }} .lp-vs__label { padding: 12px 9px; font-size: 10.5px; } #lp-vs-{{ section.id }} .lp-vs__val { padding: 12px 7px; font-size: 11.5px; } #lp-vs-{{ section.id }} .lp-vs__col-head { font-size: 9.5px; padding: 11px 6px; } }
  @media (min-width: 640px) { #lp-vs-{{ section.id }} { padding: 64px 16px 72px; } #lp-vs-{{ section.id }} .lp-vs__h { font-size: 30px; } #lp-vs-{{ section.id }} .lp-vs__sub { font-size: 15px; } #lp-vs-{{ section.id }} .lp-vs__row { grid-template-columns: 160px 1fr 1fr; } #lp-vs-{{ section.id }} .lp-vs__label { padding: 16px; font-size: 13px; } #lp-vs-{{ section.id }} .lp-vs__val { padding: 16px 14px; font-size: 13.5px; } #lp-vs-{{ section.id }} .lp-vs__col-head { font-size: 11.5px; padding: 14px 10px; letter-spacing: .8px; } #lp-vs-{{ section.id }} .lp-vs__close { padding: 24px 26px; font-size: 15px; } }
{% endstyle %}
<script>
(function () {
  var root = document.getElementById('lp-vs-{{ section.id }}'); if (!root) return;
  var cta = root.querySelector('[data-lp-vs-cta]');
  if (cta && cta.getAttribute('href').charAt(0) === '#') cta.addEventListener('click', function (e) { var t = document.querySelector(cta.getAttribute('href')); if (!t) return; e.preventDefault(); t.scrollIntoView({ behavior: 'smooth', block: 'start' }); });
})();
</script>
{% schema %}
{
  "name": "LP · Comparison table",
  "tag": "section",
  "class": "lp-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "How we compare" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "us_label", "label": "Our column label", "default": "Elaren" },
    { "type": "text", "id": "them_label", "label": "Other column label", "default": "Prescription treatments" },
    { "type": "richtext", "id": "closing", "label": "Closing text" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Choose My Plan" },
    { "type": "text", "id": "cta_link", "label": "Button link", "default": "#plan-selector" }
  ],
  "blocks": [
    { "type": "row", "name": "Row", "settings": [
      { "type": "text", "id": "label", "label": "Feature" },
      { "type": "select", "id": "us_type", "label": "Our value", "options": [ { "value": "yes", "label": "✓" }, { "value": "no", "label": "✕" }, { "value": "text", "label": "Text" } ], "default": "yes" },
      { "type": "text", "id": "us_text", "label": "Our text (if Text)" },
      { "type": "select", "id": "them_type", "label": "Other value", "options": [ { "value": "yes", "label": "✓" }, { "value": "no", "label": "✕" }, { "value": "text", "label": "Text" } ], "default": "no" },
      { "type": "text", "id": "them_text", "label": "Other text (if Text)" } ] }
  ],
  "presets": [ { "name": "LP · Comparison table", "blocks": [ { "type": "row" }, { "type": "row" }, { "type": "row" } ] } ]
}
{% endschema %}
