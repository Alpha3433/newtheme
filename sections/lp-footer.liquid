{%- render 'lp-tokens' -%}
{%- assign s = section.settings -%}
<div class="lp lp-footer" id="lp-footer-{{ section.id }}">
  <div class="lp-footer__inner">
    {%- if s.logo != blank -%}
      {{ s.logo | image_url: width: 300 | image_tag: class: 'lp-footer__logo', loading: 'lazy', alt: shop.name }}
    {%- elsif settings.logo != blank -%}
      {{ settings.logo | image_url: width: 300 | image_tag: class: 'lp-footer__logo', loading: 'lazy', alt: shop.name }}
    {%- else -%}
      <div class="lp-footer__name">{{ shop.name | escape }}</div>
    {%- endif -%}
    {%- if s.tagline != blank -%}<p class="lp-footer__tag">{{ s.tagline | escape }}</p>{%- endif -%}
    <p class="lp-footer__copy">&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}. {{ s.rights | default: 'All rights reserved.' | escape }}</p>
  </div>
</div>
{% style %}
  #lp-footer-{{ section.id }} { width: 100%; background: var(--lp-ink); padding: 36px 16px; }
  #lp-footer-{{ section.id }} .lp-footer__inner { max-width: 960px; margin: 0 auto; text-align: center; }
  #lp-footer-{{ section.id }} .lp-footer__logo { height: {{ s.logo_height | default: 32 }}px; width: auto; display: block; margin: 0 auto 14px; {% if s.invert_logo %}filter: brightness(0) invert(1);{% endif %} opacity: .95; }
  #lp-footer-{{ section.id }} .lp-footer__name { font-size: 20px; font-weight: 800; color: #fff; margin: 0 0 14px; }
  #lp-footer-{{ section.id }} .lp-footer__tag { font-size: 13px; font-weight: 500; color: rgba(255,255,255,.75); line-height: 1.5; margin: 0 0 18px; }
  #lp-footer-{{ section.id }} .lp-footer__copy { font-size: 11px; font-weight: 500; color: rgba(255,255,255,.45); letter-spacing: .3px; margin: 0; }
{% endstyle %}
{% schema %}
{
  "name": "LP · Mini footer",
  "tag": "div",
  "class": "lp-section",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Blank uses the theme logo" },
    { "type": "range", "id": "logo_height", "min": 20, "max": 80, "step": 2, "unit": "px", "label": "Logo height", "default": 32 },
    { "type": "checkbox", "id": "invert_logo", "label": "Invert logo to white", "default": true },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "A lightweight scalp serum for thinning hair." },
    { "type": "text", "id": "rights", "label": "Rights text", "default": "All rights reserved." }
  ],
  "presets": [ { "name": "LP · Mini footer" } ]
}
{% endschema %}
