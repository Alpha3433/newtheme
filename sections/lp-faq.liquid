{%- render 'lp-tokens' -%}
{%- assign s = section.settings -%}
<section class="lp lp-faqsec" id="lp-faq-{{ section.id }}">
  <div class="lp-faqsec__inner">
    {%- if s.kicker != blank -%}<div class="lp-pill">{{ s.kicker | escape }}</div>{%- endif -%}
    {%- if s.heading != blank -%}<h2 class="lp-faqsec__h">{{ s.heading | escape }}</h2>{%- endif -%}
    <div class="lp-faqsec__list">
      {%- for block in section.blocks -%}
        {%- if block.settings.question == blank -%}{%- continue -%}{%- endif -%}
        <div class="lp-faqsec__item{% if block.settings.open %} open{% endif %}" data-lp-faq {{ block.shopify_attributes }}>
          <button type="button" class="lp-faqsec__q" aria-expanded="{{ block.settings.open }}" data-lp-faq-q>
            <span>{{ block.settings.question | escape }}</span>
            <span class="lp-faqsec__icon" aria-hidden="true">+</span>
          </button>
          <div class="lp-faqsec__a">{{ block.settings.answer }}</div>
        </div>
      {%- endfor -%}
    </div>
    {%- if s.cta_label != blank -%}
      <div class="lp-faqsec__cta-wrap">
        <a class="lp-cta" href="{{ s.cta_link | default: '#plan-selector' }}" data-lp-faq-cta>{{ s.cta_label | escape }}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 6 15 12 9 18"/></svg></a>
        {%- if s.guarantee_line != blank -%}<div class="lp-faqsec__guarantee"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>{{ s.guarantee_line | escape }}</div>{%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>
{% style %}
  #lp-faq-{{ section.id }} { background: var(--lp-bg); padding: 48px 16px 56px; border-top: 1px solid var(--lp-line); }
  #lp-faq-{{ section.id }} .lp-faqsec__inner { max-width: {{ s.max_width | default: 840 }}px; margin: 0 auto; }
  #lp-faq-{{ section.id }} .lp-faqsec__h { font-size: 24px; font-weight: 800; line-height: 1.25; color: var(--lp-ink); letter-spacing: -.02em; margin: 0 0 26px; max-width: 32ch; text-wrap: balance; text-transform: none; }
  #lp-faq-{{ section.id }} .lp-faqsec__list { display: flex; flex-direction: column; gap: 10px; }
  #lp-faq-{{ section.id }} .lp-faqsec__item { background: #fff; border: 1px solid var(--lp-tint-line); border-radius: 14px; overflow: hidden; box-shadow: 0 4px 12px rgba(var(--lp-ink-rgb), .05); }
  #lp-faq-{{ section.id }} .lp-faqsec__q { display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 18px 20px; cursor: pointer; background: transparent; border: 0; width: 100%; text-align: left; font-size: 14px; font-weight: 700; color: var(--lp-ink); line-height: 1.4; }
  #lp-faq-{{ section.id }} .lp-faqsec__q:hover { background: var(--lp-bg-soft); }
  #lp-faq-{{ section.id }} .lp-faqsec__icon { width: 24px; height: 24px; border-radius: 50%; background: rgba(var(--lp-accent-rgb), .10); color: var(--lp-accent-dark); display: flex; align-items: center; justify-content: center; font-size: 18px; font-weight: 700; flex-shrink: 0; transition: transform .2s ease; line-height: 1; }
  #lp-faq-{{ section.id }} .lp-faqsec__item.open .lp-faqsec__icon { transform: rotate(45deg); }
  #lp-faq-{{ section.id }} .lp-faqsec__a { display: none; padding: 0 20px 20px; font-size: 13.5px; color: var(--lp-ink-2); line-height: 1.7; }
  #lp-faq-{{ section.id }} .lp-faqsec__a p { margin: 0 0 10px; } #lp-faq-{{ section.id }} .lp-faqsec__a p:last-child { margin: 0; }
  #lp-faq-{{ section.id }} .lp-faqsec__a strong { font-weight: 700; color: var(--lp-ink); }
  #lp-faq-{{ section.id }} .lp-faqsec__item.open .lp-faqsec__a { display: block; }
  #lp-faq-{{ section.id }} .lp-faqsec__cta-wrap { margin: 32px 0 0; text-align: center; }
  #lp-faq-{{ section.id }} .lp-faqsec__guarantee { display: inline-flex; align-items: center; gap: 7px; margin: 14px 0 0; font-size: 12px; font-weight: 600; color: var(--lp-accent-dark); }
  #lp-faq-{{ section.id }} .lp-faqsec__guarantee svg { width: 14px; height: 14px; flex-shrink: 0; }
  @media (min-width: 640px) { #lp-faq-{{ section.id }} { padding: 64px 16px 72px; } #lp-faq-{{ section.id }} .lp-faqsec__h { font-size: 30px; } }
{% endstyle %}
<script>
(function () {
  var root = document.getElementById('lp-faq-{{ section.id }}');
  if (!root || root.dataset.lpInit) return; root.dataset.lpInit = '1';
  root.querySelectorAll('[data-lp-faq-q]').forEach(function (q) {
    q.addEventListener('click', function () { var i = q.closest('[data-lp-faq]'); var o = i.classList.toggle('open'); q.setAttribute('aria-expanded', o ? 'true' : 'false'); });
  });
  var cta = root.querySelector('[data-lp-faq-cta]');
  if (cta && cta.getAttribute('href').charAt(0) === '#') cta.addEventListener('click', function (e) { var t = document.querySelector(cta.getAttribute('href')); if (!t) return; e.preventDefault(); t.scrollIntoView({ behavior: 'smooth', block: 'start' }); });
})();
</script>
{% schema %}
{
  "name": "LP · FAQ",
  "tag": "section",
  "class": "lp-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Common Questions" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently Asked Questions" },
    { "type": "range", "id": "max_width", "min": 640, "max": 1200, "step": 20, "unit": "px", "label": "Max width", "default": 840 },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Choose My Plan" },
    { "type": "text", "id": "cta_link", "label": "Button link", "default": "#plan-selector" },
    { "type": "text", "id": "guarantee_line", "label": "Line under button", "default": "90-Day Money-Back Guarantee" }
  ],
  "blocks": [
    { "type": "faq_item", "name": "Question", "settings": [
      { "type": "text", "id": "question", "label": "Question" },
      { "type": "richtext", "id": "answer", "label": "Answer" },
      { "type": "checkbox", "id": "open", "label": "Open by default", "default": false } ] }
  ],
  "presets": [ { "name": "LP · FAQ", "blocks": [ { "type": "faq_item" }, { "type": "faq_item" }, { "type": "faq_item" } ] } ]
}
{% endschema %}
