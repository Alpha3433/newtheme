{%- render 'lp-tokens' -%}
{%- liquid
  assign s = section.settings
  assign categories = ''
  for block in section.blocks
    assign category = block.settings.category | default: 'General'
    unless categories contains category
      if categories == ''
        assign categories = category
      else
        assign categories = categories | append: ',' | append: category
      endif
    endunless
  endfor
  assign category_array = categories | split: ','
  assign default_handle = s.default_category | default: 'All' | handleize
  if default_handle == blank or default_handle == 'all' or category_array.size < 2
    assign default_handle = 'all'
  else
    assign found = false
    for c in category_array
      assign ch = c | handleize
      if ch == default_handle
        assign found = true
      endif
    endfor
    unless found
      assign default_handle = 'all'
    endunless
  endif
-%}
{%- if section.blocks.size > 0 -%}
<section class="lp lp-results" id="lp-results-{{ section.id }}">
  <div class="lp-results__inner">
    <div class="lp-results__head">
      {%- if s.pill != blank -%}<div class="lp-pill">{{ s.pill | escape }}</div>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="lp-results__h">{{ s.heading | escape }}</h2>{%- endif -%}
      {%- if s.subheading != blank -%}<div class="lp-results__sub">{{ s.subheading }}</div>{%- endif -%}
    </div>
    {%- if category_array.size > 1 -%}
      <div class="lp-tabs" style="grid-template-columns: repeat({{ category_array.size | plus: 1 }}, 1fr);">
        <button type="button" class="lp-tabs__tab{% if default_handle == 'all' %} active{% endif %}" data-lp-cat="all">{{ s.all_label | default: 'All' | escape }}</button>
        {%- for c in category_array -%}{%- assign ch = c | handleize -%}<button type="button" class="lp-tabs__tab{% if ch == default_handle %} active{% endif %}" data-lp-cat="{{ ch }}">{{ c | escape }}</button>{%- endfor -%}
      </div>
    {%- endif -%}
    <div class="lp-results__grid" data-lp-results-grid>
      {%- for block in section.blocks -%}
        {%- assign ch = block.settings.category | default: 'General' | handleize -%}
        <figure class="lp-results__pair" data-cat="{{ ch }}" {% if default_handle != 'all' and ch != default_handle %}hidden{% endif %} {{ block.shopify_attributes }}>
          <div class="lp-results__pair-grid">
            <div class="lp-results__cell">
              {%- if block.settings.before_image != blank -%}{{ block.settings.before_image | image_url: width: 700 | image_tag: class: 'lp-results__pic', loading: 'lazy', alt: block.settings.before_label }}{%- endif -%}
              <span class="lp-results__label">{{ block.settings.before_label | default: 'Before' | escape }}</span>
            </div>
            <div class="lp-results__cell">
              {%- if block.settings.after_image != blank -%}{{ block.settings.after_image | image_url: width: 700 | image_tag: class: 'lp-results__pic', loading: 'lazy', alt: block.settings.after_label }}{%- endif -%}
              <span class="lp-results__label lp-results__label--after">{{ block.settings.after_label | default: 'After' | escape }}</span>
            </div>
          </div>
          {%- if block.settings.caption != blank -%}<figcaption class="lp-results__cap">{{ block.settings.caption | escape }}</figcaption>{%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
    {%- if s.disclaimer != blank -%}<p class="lp-results__disc">{{ s.disclaimer | escape }}</p>{%- endif -%}
    {%- if s.cta_label != blank -%}<div class="lp-results__cta-wrap"><a class="lp-cta" href="{{ s.cta_link | default: '#plan-selector' }}" data-scroll-to-plan-selector="true">{{ s.cta_label | escape }}</a></div>{%- endif -%}
  </div>
</section>
{% style %}
  #lp-results-{{ section.id }} { padding: 48px 16px 56px; background: var(--lp-bg-warm); border-top: 1px solid var(--lp-line); }
  #lp-results-{{ section.id }} .lp-results__inner { max-width: 1200px; margin: 0 auto; }
  #lp-results-{{ section.id }} .lp-results__head { max-width: 680px; margin: 0 auto 22px; text-align: center; }
  #lp-results-{{ section.id }} .lp-results__h { font-size: 26px; font-weight: 800; color: var(--lp-ink); letter-spacing: -.025em; line-height: 1.2; margin: 0 0 14px; text-wrap: balance; text-transform: none; }
  #lp-results-{{ section.id }} .lp-results__sub { font-size: 14.5px; color: var(--lp-ink-2); line-height: 1.65; }
  #lp-results-{{ section.id }} .lp-tabs { display: grid; gap: 6px; max-width: 620px; margin: 0 auto 24px; background: var(--lp-bg-soft); border: 1px solid var(--lp-line); border-radius: 12px; padding: 5px; }
  #lp-results-{{ section.id }} .lp-tabs__tab { appearance: none; background: transparent; border: 0; border-radius: 8px; padding: 12px 10px; cursor: pointer; font-size: 12.5px; font-weight: 700; color: var(--lp-muted); line-height: 1.2; text-align: center; transition: background .15s ease, color .15s ease; }
  #lp-results-{{ section.id }} .lp-tabs__tab.active { background: #fff; color: var(--lp-ink); box-shadow: 0 2px 6px rgba(var(--lp-ink-rgb), .10); }
  #lp-results-{{ section.id }} .lp-results__grid { display: grid; grid-template-columns: 1fr; gap: 18px; }
  #lp-results-{{ section.id }} .lp-results__pair { margin: 0; background: #fff; border: 1px solid var(--lp-tint-line); border-radius: 14px; padding: 12px; box-shadow: 0 6px 24px rgba(var(--lp-ink-rgb), .08); }
  #lp-results-{{ section.id }} .lp-results__pair[hidden] { display: none; }
  #lp-results-{{ section.id }} .lp-results__pair-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  #lp-results-{{ section.id }} .lp-results__cell { position: relative; }
  #lp-results-{{ section.id }} .lp-results__pic { width: 100%; aspect-ratio: {{ s.ratio | default: '1/1' }}; object-fit: cover; display: block; border-radius: 10px; border: 1px solid var(--lp-tint-line); background: var(--lp-tint-4); }
  #lp-results-{{ section.id }} .lp-results__label { position: absolute; left: 8px; top: 8px; display: inline-flex; align-items: center; padding: 5px 9px; background: rgba(255,255,255,.92); color: var(--lp-ink); border-radius: 999px; font-size: 9.5px; font-weight: 800; letter-spacing: 1.2px; text-transform: uppercase; line-height: 1; }
  #lp-results-{{ section.id }} .lp-results__label--after { background: var(--lp-ink); color: #fff; }
  #lp-results-{{ section.id }} .lp-results__cap { font-size: 12px; color: var(--lp-muted); text-align: center; margin: 10px 0 0; font-style: italic; line-height: 1.4; }
  #lp-results-{{ section.id }} .lp-results__disc { font-size: 11px; color: var(--lp-faint); line-height: 1.55; margin: 24px auto 0; font-style: italic; text-align: center; max-width: 680px; }
  #lp-results-{{ section.id }} .lp-results__cta-wrap { margin: 28px 0 0; text-align: center; }
  @media (min-width: 640px) { #lp-results-{{ section.id }} { padding: 56px 16px 64px; } #lp-results-{{ section.id }} .lp-results__grid { grid-template-columns: 1fr 1fr; } #lp-results-{{ section.id }} .lp-results__h { font-size: 30px; } }
  @media (min-width: 980px) { #lp-results-{{ section.id }} { padding: 72px 24px 88px; } #lp-results-{{ section.id }} .lp-results__grid { grid-template-columns: repeat({{ s.columns | default: 3 }}, 1fr); gap: 24px; } #lp-results-{{ section.id }} .lp-results__h { font-size: 36px; letter-spacing: -.03em; } }
{% endstyle %}
<script>
(function () {
  var root = document.getElementById('lp-results-{{ section.id }}');
  if (!root || root.dataset.lpInit) return; root.dataset.lpInit = '1';
  root.querySelectorAll('[data-lp-cat]').forEach(function (t) {
    t.addEventListener('click', function () {
      root.querySelectorAll('[data-lp-cat]').forEach(function (x) { x.classList.toggle('active', x === t); });
      var cat = t.dataset.lpCat;
      root.querySelectorAll('.lp-results__pair').forEach(function (p) { p.hidden = !(cat === 'all' || p.dataset.cat === cat); });
    });
  });
  var cta = root.querySelector('[data-scroll-to-plan-selector]');
  if (cta) cta.addEventListener('click', function (e) { var t = document.getElementById('plan-selector'); if (!t) return; e.preventDefault(); t.scrollIntoView({ behavior: 'smooth', block: 'start' }); });
})();
</script>
{%- endif -%}
{% schema %}
{
  "name": "LP · Before & after results",
  "tag": "section",
  "class": "lp-section",
  "settings": [
    { "type": "text", "id": "pill", "label": "Pill", "default": "Before & After" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real Results In 90 Days" },
    { "type": "richtext", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "all_label", "label": "'All' tab label", "default": "All" },
    { "type": "text", "id": "default_category", "label": "Default active tab", "default": "All", "info": "Category tag to show first, e.g. Women. Must match a block's category." },
    { "type": "select", "id": "ratio", "label": "Image ratio", "options": [ { "value": "1/1", "label": "Square" }, { "value": "3/4", "label": "Portrait 3:4" }, { "value": "4/5", "label": "Portrait 4:5" } ], "default": "1/1" },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns (desktop)", "default": 3 },
    { "type": "text", "id": "disclaimer", "label": "Disclaimer", "default": "Individual results vary." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Choose My Plan" },
    { "type": "text", "id": "cta_link", "label": "Button link", "default": "#plan-selector" }
  ],
  "blocks": [
    { "type": "before_and_after", "name": "Before & after pair", "settings": [
      { "type": "text", "id": "before_label", "label": "Before label", "default": "Before" },
      { "type": "image_picker", "id": "before_image", "label": "Before image" },
      { "type": "text", "id": "after_label", "label": "After label", "default": "After 90 Days" },
      { "type": "image_picker", "id": "after_image", "label": "After image" },
      { "type": "text", "id": "category", "label": "Category tag", "default": "General" },
      { "type": "text", "id": "caption", "label": "Caption" } ] }
  ],
  "presets": [ { "name": "LP · Before & after results", "blocks": [ { "type": "before_and_after" }, { "type": "before_and_after" }, { "type": "before_and_after" } ] } ]
}
{% endschema %}
