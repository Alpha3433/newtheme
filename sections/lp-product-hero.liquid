    .lp-option__desc { font-size: 11.5px; }
    .lp-price { font-size: 13.5px; } .lp-price-was { font-size: 11px; }
    .lp-hero__cta { padding: 12px 14px 10px; font-size: 12.5px; letter-spacing: .9px; }
    .lp-hero__cta-sub { font-size: 9px; letter-spacing: 1.2px; }
