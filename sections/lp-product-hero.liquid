{%- comment -%}
  LP Product Hero — gallery + buy box + accordions, laid out like a
  direct-response landing page. All colours come from snippets/lp-tokens.

  Plan cards are data-driven: each card points at a variant index, the price,
  compare-at price and (optional) subscription allocation are read from the
  product at render time, so nothing about pricing is typed by hand.
{%- endcomment -%}
{%- render 'lp-tokens' -%}
<script src="{{ 'product-form.js' | asset_url }}" defer></script>

{%- liquid
  assign s = section.settings
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'lp-product-form-' | append: section.id
  assign plan_blocks = section.blocks | where: 'type', 'plan_card'
  assign expert_blocks = section.blocks | where: 'type', 'expert'
  assign pill_blocks = section.blocks | where: 'type', 'trust_pill'
  assign faq_blocks = section.blocks | where: 'type', 'accordion'
  assign media_images = product.media | where: 'media_type', 'image'
  assign use_theme_plans = false
  if s.plan_mode == 'theme' and plan_blocks.size > 0
    assign use_theme_plans = true
  endif
-%}

<section class="lp lp-hero" id="lp-hero-{{ section.id }}" data-lp-hero data-section-id="{{ section.id }}" style="background: {{ s.background_color | default: 'var(--lp-bg)' }};">
  <div class="lp-hero__grid{% if s.gallery_left %} flip-cols{% endif %}">

    {%- comment -%} ───────────────── INFO ───────────────── {%- endcomment -%}
    <div class="lp-hero__info">
      {%- assign in_list = false -%}
      {%- for block in section.blocks -%}
        {%- if block.type != 'bullet' and in_list -%}
          </ul>
          {%- assign in_list = false -%}
        {%- endif -%}
        {%- case block.type -%}
          {%- when 'rating' -%}
            <a class="lp-hero__rating" href="{{ block.settings.link | default: '#reviews' }}" data-scroll-to-reviews {{ block.shopify_attributes }}>
              <span class="lp-hero__rating-num">{{ block.settings.rating | escape }}</span>
              <span class="lp-hero__rating-stars" aria-hidden="true">★★★★★</span>
              <span class="lp-hero__rating-count">({{ block.settings.count | escape }})</span>
            </a>
          {%- when 'title' -%}
            <h1 class="lp-hero__title" {{ block.shopify_attributes }}>
              {%- if block.settings.title != blank -%}{{ block.settings.title | escape }}{%- else -%}{{ product.title | escape }}{%- endif -%}
              {%- if block.settings.second_line != blank -%}<br>{{ block.settings.second_line | escape }}{%- endif -%}
            </h1>
          {%- when 'text' -%}
            <div class="lp-hero__desc" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'bullet' -%}
            {%- unless in_list -%}
              <ul class="lp-hero__bullets">
              {%- assign in_list = true -%}
            {%- endunless -%}
            <li class="lp-hero__bullet" {{ block.shopify_attributes }}>
              <span class="lp-hero__bullet-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
              <span>{%- if block.settings.lead != blank -%}<strong>{{ block.settings.lead | escape }}</strong> {% endif -%}{{ block.settings.text | escape }}</span>
            </li>
        {%- endcase -%}
      {%- endfor -%}
      {%- if in_list -%}</ul>{%- endif -%}

      {%- comment -%} Expert / KOL carousel {%- endcomment -%}
      {%- if expert_blocks.size > 0 -%}
        <div class="lp-kol" data-lp-kol>
          <div class="lp-kol__track-wrap">
            <div class="lp-kol__track" data-lp-kol-track>
              {%- for block in expert_blocks -%}
                <div class="lp-kol__slot" {{ block.shopify_attributes }}>
                  <div class="lp-kol__card">
                    <div class="lp-kol__head">
                      {%- if block.settings.image != blank -%}
                        {{ block.settings.image | image_url: width: 120 | image_tag: class: 'lp-kol__pfp', loading: 'lazy', alt: block.settings.name }}
                      {%- else -%}
                        <span class="lp-kol__pfp lp-kol__pfp--empty" aria-hidden="true"></span>
                      {%- endif -%}
                      <div class="lp-kol__info">
                        <div class="lp-kol__name-row">
                          <span class="lp-kol__name">{{ block.settings.name | escape }}</span>
                          {%- if block.settings.verified -%}
                            <svg class="lp-kol__badge" viewBox="0 0 24 24" aria-label="Verified"><circle cx="12" cy="12" r="11" fill="var(--lp-accent)"/><path d="M7 12.5l3 3 7-7" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                          {%- endif -%}
                        </div>
                        <div class="lp-kol__cred">{{ block.settings.credential | escape }}</div>
                      </div>
                    </div>
                    <p class="lp-kol__quote">{{ block.settings.quote | escape }}</p>
                    {%- if block.settings.long_text != blank -%}
                      <button type="button" class="lp-kol__more" data-lp-kol-open data-name="{{ block.settings.name | escape }}" data-cred="{{ block.settings.credential | escape }}" data-body="{{ block.settings.long_text | strip_html | escape }}">
                        {{ s.expert_more_label | default: 'Know More' | escape }}
                        <span class="lp-kol__more-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"/></svg></span>
                      </button>
                    {%- endif -%}
                  </div>
                </div>
              {%- endfor -%}
            </div>
          </div>
          {%- if expert_blocks.size > 1 -%}
            <div class="lp-kol__controls">
              <button type="button" class="lp-kol__arrow" data-lp-kol-prev aria-label="Previous"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 6 9 12 15 18"/></svg></button>
              <div class="lp-kol__dots" data-lp-kol-dots>
                {%- for block in expert_blocks -%}<button type="button" class="lp-kol__dot{% if forloop.first %} active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="Slide {{ forloop.index }}"></button>{%- endfor -%}
              </div>
              <button type="button" class="lp-kol__arrow" data-lp-kol-next aria-label="Next"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"/></svg></button>
            </div>
          {%- endif -%}
          <div class="lp-modal" data-lp-kol-modal hidden>
            <div class="lp-modal__inner" role="dialog" aria-modal="true">
              <button type="button" class="lp-modal__close" data-lp-modal-close aria-label="Close"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
              <div class="lp-modal__name" data-lp-modal-name></div>
              <div class="lp-modal__cred" data-lp-modal-cred></div>
              <p class="lp-modal__body" data-lp-modal-body></p>
            </div>
          </div>
        </div>
      {%- endif -%}

      {%- comment -%} ───────────────── PURCHASE ───────────────── {%- endcomment -%}
      <div class="lp-hero__purchase" id="plan-selector" style="scroll-margin-top: 90px;">
        {%- if s.bundle_heading != blank -%}<h3 class="lp-hero__bundle-h">{{ s.bundle_heading | escape }}</h3>{%- endif -%}

        <product-form class="product-form" data-section-id="{{ section.id }}">
          {%- form 'product', product, id: form_id, class: 'form lp-hero__form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
            <input type="hidden" name="id" class="product-variant-id" value="{{ current_variant.id }}" {% if current_variant == null or current_variant.available == false %}disabled{% endif %}>
            <input type="hidden" name="selling_plan" value="" data-lp-selling-plan>

            {%- if use_theme_plans -%}
              <div class="lp-options" data-lp-options data-one-time-single="{{ s.one_time_single_card }}" role="radiogroup" aria-label="{{ s.bundle_heading | default: 'Choose your plan' | escape }}">
                {%- assign has_default = false -%}
                {%- for block in plan_blocks -%}
                  {%- liquid
                    assign vi = block.settings.variant_index | default: forloop.index | minus: 1
                    assign v = product.variants[vi]
                    if v == blank
                      continue
                    endif
                    assign alloc = blank
                    for a in v.selling_plan_allocations
                      if block.settings.plan_match != blank
                        assign nm = a.selling_plan.name | downcase
                        assign needle = block.settings.plan_match | downcase
                        if nm contains needle
                          assign alloc = a
                          break
                        endif
                      else
                        assign alloc = a
                        break
                      endif
                    endfor
                    assign is_selected = false
                    if block.settings.selected and has_default == false
                      assign is_selected = true
                      assign has_default = true
                    endif
                    if forloop.last and has_default == false
                      assign is_selected = true
                      assign has_default = true
                    endif
                    assign card_title = block.settings.title | default: v.title
                    assign compare = v.compare_at_price | default: 0
                    assign plan_price = 0
                    assign plan_compare = 0
                    assign plan_id = ''
                    assign plan_name = ''
                    if alloc != blank
                      assign plan_price = alloc.price
                      assign plan_compare = alloc.compare_at_price | default: v.compare_at_price | default: 0
                      assign plan_id = alloc.selling_plan.id
                      assign plan_name = alloc.selling_plan.name
                    endif
                  -%}
                  <label class="lp-option lp-option--{{ block.settings.style }}{% if is_selected %} active{% endif %}{% unless v.available %} lp-option--soldout{% endunless %}"
                    data-lp-option
                    data-variant-id="{{ v.id }}"
                    data-available="{{ v.available }}"
                    data-price="{{ v.price | money }}"
                    data-price-cents="{{ v.price }}"
                    data-compare="{% if compare > v.price %}{{ compare | money }}{% endif %}"
                    data-compare-cents="{{ compare }}"
                    data-plan-id="{{ plan_id }}"
                    data-plan-name="{{ plan_name | escape }}"
                    data-plan-price="{% if alloc != blank %}{{ plan_price | money }}{% endif %}"
                    data-plan-price-cents="{{ plan_price }}"
                    data-plan-compare="{% if alloc != blank and plan_compare > plan_price %}{{ plan_compare | money }}{% endif %}"
                    data-plan-compare-cents="{{ plan_compare }}"
                    {{ block.shopify_attributes }}>
                    {%- if block.settings.banner != blank -%}<span class="lp-option__banner">{{ block.settings.banner | escape }}</span>{%- endif -%}
                    <span class="lp-option__body">
                      <input type="radio" class="lp-option__radio" name="lp-plan-{{ section.id }}" value="{{ v.id }}" {% if is_selected %}checked{% endif %} {% unless v.available %}disabled{% endunless %}>
                      <span class="lp-option__info">
                        <span class="lp-option__title">{{ card_title | escape }}</span>
                        {%- if block.settings.subtitle != blank -%}<span class="lp-option__desc">{{ block.settings.subtitle | escape }}</span>{%- endif -%}
                        <span class="lp-option__meta">
                          {%- if block.settings.pills != blank -%}
                            {%- assign pills = block.settings.pills | split: ',' -%}
                            {%- for p in pills -%}
                              <span class="lp-option__bundle-item">{%- if v.featured_image != blank -%}{{ v.featured_image | image_url: width: 40 | image_tag: class: 'lp-option__bundle-icon', loading: 'lazy', alt: '' }}{%- endif -%}{{ p | strip | escape }}</span>
                            {%- endfor -%}
                          {%- endif -%}
                          <span class="lp-option__saved-pill" data-lp-saved hidden></span>
                        </span>
                      </span>
                      <span class="lp-option__price">
                        <span class="lp-price" data-lp-price>{{ v.price | money }}</span>
                        <span class="lp-price-was" data-lp-was {% unless compare > v.price %}hidden{% endunless %}>{% if compare > v.price %}{{ compare | money }}{% endif %}</span>
                      </span>
                    </span>
                  </label>
                {%- endfor -%}
              </div>

              {%- if s.show_autoship -%}
                <label class="lp-autoship{% if s.autoship_default %} active{% endif %}" data-lp-autoship>
                  <input type="checkbox" class="lp-autoship__input" {% if s.autoship_default %}checked{% endif %} data-lp-autoship-input>
                  <span class="lp-autoship__box" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
                  <span class="lp-autoship__label">{{ s.autoship_label | escape }}</span>
                  <span class="lp-autoship__pill" data-lp-autoship-pill hidden></span>
                </label>
                <div class="lp-frequency" data-lp-frequency>
                  <button type="button" class="lp-frequency__toggle" aria-expanded="false" data-lp-frequency-toggle>
                    <span class="lp-frequency__h">{{ s.frequency_heading | default: 'Subscription details' | escape }}</span>
                    <span class="lp-frequency__chev" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg></span>
                  </button>
                  <ul class="lp-frequency__list" hidden>
                    <li data-lp-frequency-plan></li>
                    {%- assign notes = s.subscription_notes | newline_to_br | split: '<br />' -%}
                    {%- for n in notes -%}{%- assign nt = n | strip -%}{%- if nt != blank -%}<li>{{ nt }}</li>{%- endif -%}{%- endfor -%}
                  </ul>
                </div>
              {%- endif -%}
            {%- else -%}
              {%- comment -%} App mode: the subscription app injects its own selector into this form. {%- endcomment -%}
              <div class="lp-hero__app-selector" data-lp-app-selector></div>
            {%- endif -%}

            {%- if s.offer_line != blank -%}
              <div class="lp-offer-badge">
                <span class="lp-offer-badge__check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
                <span class="lp-offer-badge__text">{{ s.offer_line }}</span>
              </div>
            {%- endif -%}

            <button type="submit" name="add" class="lp-hero__cta product-form__submit disable-global-button-styling{% if current_variant.available == false %} sold-out{% endif %}" {% if current_variant.available == false %}disabled{% endif %} data-lp-cta>
              <span class="lp-hero__cta-main">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6h15l-1.5 9h-12z"/><circle cx="9" cy="20" r="1.5"/><circle cx="18" cy="20" r="1.5"/><path d="M6 6L5 3H2"/></svg>
                <span class="button-text">{%- if current_variant.available == false -%}{{ 'products.product.sold_out' | t }}{%- else -%}{{ s.cta_label | escape }}{%- endif -%}</span>
              </span>
              {%- if s.cta_sublabel != blank -%}<span class="lp-hero__cta-sub">{{ s.cta_sublabel | escape }}</span>{%- endif -%}
              <div class="loading__spinner hidden"><svg aria-hidden="true" focusable="false" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg"><circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle></svg></div>
            </button>
          {%- endform -%}
        </product-form>

        {%- if pill_blocks.size > 0 -%}
          <div class="lp-trust">
            {%- for block in pill_blocks -%}
              <span class="lp-trust__item" {{ block.shopify_attributes }}>
                {%- case block.settings.icon -%}
                  {%- when 'check' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><polyline points="8 12 11 15 16 9"/></svg>
                  {%- when 'shield' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
                  {%- when 'truck' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/></svg>
                  {%- when 'leaf' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 20c0-8 5-14 15-15-1 10-7 15-15 15z"/><path d="M5 20l9-9"/></svg>
                  {%- when 'star' -%}<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4 6.1 20.5l1.2-6.5L2.5 9.4l6.6-.9z"/></svg>
                  {%- when 'clock' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15 14"/></svg>
                  {%- when 'drop' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11z"/></svg>
                  {%- else -%}{%- if block.settings.emoji != blank -%}<span aria-hidden="true">{{ block.settings.emoji }}</span>{%- endif -%}
                {%- endcase -%}
                {{ block.settings.text | escape }}
              </span>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if s.promise_text != blank -%}
          <div class="lp-promise">
            {%- if s.promise_image != blank -%}
              {{ s.promise_image | image_url: width: 120 | image_tag: class: 'lp-promise__badge', loading: 'lazy', alt: s.promise_image.alt }}
            {%- else -%}
              <span class="lp-promise__badge lp-promise__badge--svg" aria-hidden="true"><svg viewBox="0 0 64 64"><circle cx="32" cy="32" r="30" fill="var(--lp-accent)"/><circle cx="32" cy="32" r="24" fill="none" stroke="#fff" stroke-width="2" stroke-dasharray="3 3"/><path d="M20 33l8 8 16-17" fill="none" stroke="#fff" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            {%- endif -%}
            <span>{{ s.promise_text }}</span>
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} ───────────────── GALLERY ───────────────── {%- endcomment -%}
    <div class="lp-hero__gallery" data-lp-gallery>
      <div class="lp-stage-wrap" style="aspect-ratio: {{ s.image_ratio | default: '1/1' }};">
        <div class="lp-stage" data-lp-stage>
          {%- for media in media_images -%}
            {%- liquid
              assign img_alt = media.alt | default: product.title
              if forloop.first
                assign img_loading = 'eager'
              else
                assign img_loading = 'lazy'
              endif
            -%}
            <div class="lp-slide" data-index="{{ forloop.index0 }}">
              {{ media | image_url: width: 1200 | image_tag: loading: img_loading, sizes: '(min-width: 980px) 560px, 100vw', widths: '400, 600, 800, 1000, 1200', alt: img_alt }}
            </div>
          {%- else -%}
            <div class="lp-slide">{{ 'product-1' | placeholder_svg_tag: 'lp-slide__placeholder' }}</div>
          {%- endfor -%}
        </div>
      </div>
      {%- if media_images.size > 1 and s.show_thumbnails -%}
        <div class="lp-thumbs-wrap">
          <button type="button" class="lp-thumb-arrow" data-lp-prev aria-label="Previous image"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 6 9 12 15 18"/></svg></button>
          <div class="lp-thumbs" data-lp-thumbs>
            {%- for media in media_images -%}
              <button type="button" class="lp-thumb{% if forloop.first %} active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="Image {{ forloop.index }}">
                {{ media | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
              </button>
            {%- endfor -%}
          </div>
          <button type="button" class="lp-thumb-arrow" data-lp-next aria-label="Next image"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"/></svg></button>
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} ───────────────── ACCORDIONS ───────────────── {%- endcomment -%}
    {%- if faq_blocks.size > 0 -%}
      <div class="lp-hero__faq">
        <ul class="lp-faq__list">
          {%- for block in faq_blocks -%}
            {%- if block.settings.title == blank -%}{%- continue -%}{%- endif -%}
            <li class="lp-faq__item{% if block.settings.open %} open{% endif %}" data-lp-faq-item {{ block.shopify_attributes }}>
              <button type="button" class="lp-faq__q" aria-expanded="{{ block.settings.open }}" data-lp-faq-q>
                <span class="lp-faq__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></span>
                <span class="lp-faq__title">{{ block.settings.title | escape }}</span>
              </button>
              <div class="lp-faq__a">{{ block.settings.content }}</div>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </div>
</section>

{% style %}
  #lp-hero-{{ section.id }} { width: 100%; overflow-x: clip; }
  #lp-hero-{{ section.id }} .lp-hero__grid { max-width: 680px; margin: 0 auto; padding: 20px 16px 40px; display: grid; grid-template-areas: "gallery" "info" "faq"; gap: 24px; align-items: start; }
  #lp-hero-{{ section.id }} .lp-hero__gallery { grid-area: gallery; width: 100%; }
  #lp-hero-{{ section.id }} .lp-hero__info { grid-area: info; padding: 0 4px; }
  #lp-hero-{{ section.id }} .lp-hero__faq { grid-area: faq; }

  /* info */
  .lp-hero__rating { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin: 0 0 16px; font-size: 13.5px; font-weight: 700; color: var(--lp-ink); line-height: 1.2; text-decoration: none; }
  .lp-hero__rating-num { font-weight: 800; font-size: 14px; }
  .lp-hero__rating-stars { display: inline-flex; gap: 1px; color: var(--lp-star); font-size: 15px; line-height: 1; letter-spacing: .5px; }
  .lp-hero__rating-count { color: var(--lp-muted); font-weight: 500; font-size: 12.5px; }
  .lp-hero__title { font-size: 22px; font-weight: 800; color: var(--lp-ink); letter-spacing: -.02em; line-height: 1.25; margin: 0 0 16px; text-transform: none; }
  .lp-hero__desc { font-size: 14.5px; font-weight: 400; color: var(--lp-ink-2); line-height: 1.65; margin: 0 0 18px; }
  .lp-hero__desc p { margin: 0 0 10px; } .lp-hero__desc p:last-child { margin: 0; }
  .lp-hero__desc strong { font-weight: 700; color: var(--lp-ink); }
  .lp-hero__bullets { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .lp-hero__bullet { display: flex; align-items: flex-start; gap: 11px; font-size: 14px; font-weight: 600; color: var(--lp-ink); line-height: 1.45; }
  .lp-hero__bullet-check { flex-shrink: 0; width: 20px; height: 20px; border-radius: 50%; background: var(--lp-accent); display: inline-flex; align-items: center; justify-content: center; color: #fff; margin-top: 1px; }
