{% endstyle %}

<script>
(function () {
  var root = document.getElementById('lp-hero-{{ section.id }}');
  if (!root || root.dataset.lpInit) return;
  root.dataset.lpInit = '1';

  /* ---------- gallery ---------- */
  var stage = root.querySelector('[data-lp-stage]');
  if (stage) {
    var slides = stage.querySelectorAll('.lp-slide');
    var thumbs = root.querySelectorAll('.lp-thumb');
    var index = 0;
    var go = function (i) {
      index = (i + slides.length) % slides.length;
      stage.style.transform = 'translateX(' + (-100 * index) + '%)';
      thumbs.forEach(function (t, j) { t.classList.toggle('active', j === index); });
      if (thumbs[index]) thumbs[index].scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
    };
    thumbs.forEach(function (t) { t.addEventListener('click', function () { go(parseInt(t.dataset.index, 10)); }); });
    var prev = root.querySelector('[data-lp-prev]'), next = root.querySelector('[data-lp-next]');
    if (prev) prev.addEventListener('click', function () { go(index - 1); });
    if (next) next.addEventListener('click', function () { go(index + 1); });
    var startX = null, dragging = false, width = 1;
    stage.addEventListener('pointerdown', function (e) { startX = e.clientX; width = stage.clientWidth || 1; dragging = true; stage.classList.add('dragging'); });
    stage.addEventListener('pointermove', function (e) {
      if (!dragging || startX === null) return;
      var dx = e.clientX - startX;
      stage.style.transform = 'translateX(calc(' + (-100 * index) + '% + ' + dx + 'px))';
    });
    var end = function (e) {
      if (!dragging) return;
      dragging = false; stage.classList.remove('dragging');
      var dx = (e.clientX || 0) - startX;
      if (Math.abs(dx) > width * 0.15) go(dx < 0 ? index + 1 : index - 1); else go(index);
      startX = null;
    };
    stage.addEventListener('pointerup', end);
    stage.addEventListener('pointercancel', end);
    stage.addEventListener('pointerleave', function (e) { if (dragging) end(e); });
  }

  /* ---------- accordions ---------- */
  root.querySelectorAll('[data-lp-faq-q]').forEach(function (q) {
    q.addEventListener('click', function () {
      var item = q.closest('[data-lp-faq-item]');
      var open = item.classList.toggle('open');
      q.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  });

  /* ---------- expert carousel ---------- */
  var kol = root.querySelector('[data-lp-kol]');
  if (kol) {
    var track = kol.querySelector('[data-lp-kol-track]');
    var slots = track.querySelectorAll('.lp-kol__slot');
    var dots = kol.querySelectorAll('.lp-kol__dot');
    var k = 0;
    var kgo = function (i) { k = (i + slots.length) % slots.length; track.style.transform = 'translateX(' + (-100 * k) + '%)'; dots.forEach(function (d, j) { d.classList.toggle('active', j === k); }); };
    dots.forEach(function (d) { d.addEventListener('click', function () { kgo(parseInt(d.dataset.index, 10)); }); });
    var kp = kol.querySelector('[data-lp-kol-prev]'), kn = kol.querySelector('[data-lp-kol-next]');
    if (kp) kp.addEventListener('click', function () { kgo(k - 1); });
    if (kn) kn.addEventListener('click', function () { kgo(k + 1); });
    var modal = kol.querySelector('[data-lp-kol-modal]');
    kol.querySelectorAll('[data-lp-kol-open]').forEach(function (b) {
      b.addEventListener('click', function () {
        modal.querySelector('[data-lp-modal-name]').textContent = b.dataset.name || '';
        modal.querySelector('[data-lp-modal-cred]').textContent = b.dataset.cred || '';
        modal.querySelector('[data-lp-modal-body]').textContent = b.dataset.body || '';
        modal.hidden = false;
      });
    });
    if (modal) {
      modal.querySelector('[data-lp-modal-close]').addEventListener('click', function () { modal.hidden = true; });
      modal.addEventListener('click', function (e) { if (e.target === modal) modal.hidden = true; });
    }
  }

  /* ---------- plan cards + autoship ---------- */
  var options = root.querySelectorAll('[data-lp-option]');
  var form = root.querySelector('form[data-type="add-to-cart-form"]');
  if (options.length && form) {
    var idInput = form.querySelector('[name="id"]');
    var planInput = form.querySelector('[data-lp-selling-plan]');
    var autoship = root.querySelector('[data-lp-autoship]');
    var autoInput = root.querySelector('[data-lp-autoship-input]');
    var autoPill = root.querySelector('[data-lp-autoship-pill]');
    var freq = root.querySelector('[data-lp-frequency]');
    var freqPlan = root.querySelector('[data-lp-frequency-plan]');
    var cta = root.querySelector('[data-lp-cta]');
    var money = function (cents) {
      var sample = options[0].dataset.price || '$0.00';
      var num = (cents / 100).toFixed(2);
      var m = sample.match(/^([^0-9]*)([0-9.,]+)(.*)$/);
      if (!m) return num;
      var usesComma = m[2].indexOf(',') > -1 && m[2].indexOf('.') === -1;
      if (usesComma) num = num.replace('.', ',');
      return m[1] + num + m[3];
    };
    var subscribing = function () { return !!(autoInput && autoInput.checked); };
    var optionsWrap = root.querySelector('[data-lp-options]');
    var singleWhenOneTime = optionsWrap && optionsWrap.dataset.oneTimeSingle === 'true';
    var render = function () {
      var sub = subscribing();
      var current = null;
      if (singleWhenOneTime) {
        options.forEach(function (o, i) {
          var radio = o.querySelector('input[type="radio"]');
          var hide = !sub && i > 0;
          o.hidden = hide;
          if (hide && radio.checked) { radio.checked = false; options[0].querySelector('input[type="radio"]').checked = true; }
        });
      }
      options.forEach(function (o) {
        var d = o.dataset;
        var hasPlan = !!d.planId;
        var useSub = sub && hasPlan;
        var priceCents = parseInt(useSub ? d.planPriceCents : d.priceCents, 10) || 0;
        var compareCents = parseInt(useSub ? (d.planCompareCents || d.compareCents) : d.compareCents, 10) || 0;
        if (useSub && compareCents < parseInt(d.priceCents, 10)) compareCents = parseInt(d.priceCents, 10);
        o.querySelector('[data-lp-price]').textContent = useSub ? d.planPrice : d.price;
        var was = o.querySelector('[data-lp-was]');
        if (compareCents > priceCents) { was.textContent = money(compareCents); was.hidden = false; } else { was.hidden = true; }
        var saved = o.querySelector('[data-lp-saved]');
        if (compareCents > priceCents) { saved.textContent = 'Save ' + money(compareCents - priceCents); saved.hidden = false; } else { saved.hidden = true; }
        var radio = o.querySelector('input[type="radio"]');
        o.classList.toggle('active', radio.checked);
        if (radio.checked) current = o;
      });
      if (current) {
        idInput.value = current.dataset.variantId;
        var useSubNow = sub && !!current.dataset.planId;
        planInput.value = useSubNow ? current.dataset.planId : '';
        if (freqPlan) freqPlan.textContent = useSubNow ? (current.dataset.planName + ' · ' + current.dataset.planPrice + ' per delivery') : '';
        if (freq) freq.hidden = !useSubNow;
        if (autoPill) {
          var pc = parseInt(current.dataset.priceCents, 10), pp = parseInt(current.dataset.planPriceCents, 10);
          if (current.dataset.planId && pp > 0 && pp < pc) { autoPill.textContent = 'Save ' + Math.round((pc - pp) / pc * 100) + '%'; autoPill.hidden = false; } else { autoPill.hidden = true; }
        }
        if (autoship) autoship.hidden = !current.dataset.planId;
        if (cta) {
          var avail = current.dataset.available === 'true';
          cta.disabled = !avail; cta.classList.toggle('sold-out', !avail);
        }
      }
      if (autoship) autoship.classList.toggle('active', sub);
    };
    options.forEach(function (o) {
      var radio = o.querySelector('input[type="radio"]');
      radio.addEventListener('change', render);
      o.addEventListener('click', function () { if (!radio.disabled && !radio.checked) { radio.checked = true; render(); } });
    });
    if (autoInput) autoInput.addEventListener('change', render);
    var ft = root.querySelector('[data-lp-frequency-toggle]');
    if (ft) ft.addEventListener('click', function () { var list = ft.nextElementSibling; var open = list.hidden; list.hidden = !open; ft.setAttribute('aria-expanded', open ? 'true' : 'false'); });
    render();
  }
})();
</script>

{% schema %}
{
  "name": "LP · Product hero",
  "tag": "section",
  "class": "lp-section",
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "checkbox", "id": "gallery_left", "label": "Gallery on the left (desktop)", "default": false },
    { "type": "checkbox", "id": "show_thumbnails", "label": "Show thumbnails", "default": true },
    { "type": "select", "id": "image_ratio", "label": "Image ratio", "options": [ { "value": "1/1", "label": "Square" }, { "value": "4/5", "label": "Portrait 4:5" }, { "value": "3/4", "label": "Portrait 3:4" } ], "default": "1/1" },
    { "type": "range", "id": "max_width", "min": 960, "max": 1400, "step": 20, "unit": "px", "label": "Max width (desktop)", "default": 1200 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#ffffff" },
    { "type": "header", "content": "Plan selector" },
    { "type": "select", "id": "plan_mode", "label": "Plan selector", "options": [ { "value": "theme", "label": "Theme plan cards (below)" }, { "value": "app", "label": "Subscription app widget" } ], "default": "theme", "info": "Theme cards read prices and subscription plans straight from the product. If the subscription app also injects its widget into the form, switch its widget placement off for this template or pick 'app' here." },
    { "type": "text", "id": "bundle_heading", "label": "Heading", "default": "Choose Your Plan" },
    { "type": "checkbox", "id": "show_autoship", "label": "Show subscribe toggle", "default": true },
    { "type": "checkbox", "id": "autoship_default", "label": "Subscribe selected by default", "default": true },
    { "type": "checkbox", "id": "one_time_single_card", "label": "When subscribe is off, show only the first card", "default": true, "info": "Use when the variants are delivery cadences of the same product, so a one-time purchase has a single option." },
    { "type": "text", "id": "autoship_label", "label": "Subscribe toggle label", "default": "Subscribe & Save + Free Shipping" },
    { "type": "text", "id": "frequency_heading", "label": "Subscription details heading", "default": "Subscription details" },
    { "type": "textarea", "id": "subscription_notes", "label": "Subscription details (one per line)", "default": "Free shipping on every order\nCancel or pause anytime" },
    { "type": "richtext", "id": "offer_line", "label": "Applied offer line (optional)" },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Add to cart" },
    { "type": "text", "id": "cta_sublabel", "label": "Button sub-label", "default": "90-Day Money-Back Guarantee" },
    { "type": "header", "content": "Promise box" },
    { "type": "image_picker", "id": "promise_image", "label": "Badge image (optional)" },
    { "type": "richtext", "id": "promise_text", "label": "Promise text", "default": "<p>Your order is protected by a <strong>90-Day Money-Back Guarantee</strong> — no return needed. If you're not seeing fuller hair by day 90, email us for a full refund.</p>" },
    { "type": "header", "content": "Experts" },
    { "type": "text", "id": "expert_more_label", "label": "'Know more' label", "default": "Know More" }
  ],
  "blocks": [
    { "type": "rating", "name": "Rating row", "limit": 1, "settings": [
      { "type": "text", "id": "rating", "label": "Rating", "default": "4.8" },
      { "type": "text", "id": "count", "label": "Count text", "default": "43 reviews" },
      { "type": "text", "id": "link", "label": "Link", "default": "#reviews" } ] },
    { "type": "title", "name": "Title", "limit": 1, "settings": [
      { "type": "text", "id": "title", "label": "Title override", "info": "Leave blank to use the product title" },
      { "type": "text", "id": "second_line", "label": "Second line" } ] },
    { "type": "text", "name": "Description", "settings": [ { "type": "richtext", "id": "text", "label": "Text" } ] },
    { "type": "bullet", "name": "Benefit bullet", "settings": [
      { "type": "text", "id": "lead", "label": "Bold lead", "info": "e.g. 'Less shedding'" },
      { "type": "text", "id": "text", "label": "Text" } ] },
    { "type": "expert", "name": "Expert card", "settings": [
      { "type": "image_picker", "id": "image", "label": "Photo" },
      { "type": "text", "id": "name", "label": "Name" },
      { "type": "checkbox", "id": "verified", "label": "Verified badge", "default": true },
      { "type": "text", "id": "credential", "label": "Credential" },
      { "type": "textarea", "id": "quote", "label": "Short quote" },
      { "type": "richtext", "id": "long_text", "label": "Full text (opens in a modal)" } ] },
    { "type": "plan_card", "name": "Plan card", "settings": [
      { "type": "number", "id": "variant_index", "label": "Variant number", "info": "1 = first variant, 2 = second… Leave blank to use the card's position." },
      { "type": "text", "id": "plan_match", "label": "Subscription plan contains", "info": "Optional. Text to match in the selling plan name, e.g. 'every 3 months'. Blank uses the variant's first plan." },
      { "type": "text", "id": "banner", "label": "Banner label", "info": "e.g. 'Most popular'. Leave blank for none." },
      { "type": "text", "id": "title", "label": "Title", "info": "Blank = variant title" },
      { "type": "text", "id": "subtitle", "label": "Subtitle" },
      { "type": "text", "id": "pills", "label": "Small pills (comma separated)", "info": "e.g. '1× Serum'" },
      { "type": "select", "id": "style", "label": "Style", "options": [ { "value": "default", "label": "Default" }, { "value": "popular", "label": "Popular" }, { "value": "best", "label": "Best value" } ], "default": "default" },
      { "type": "checkbox", "id": "selected", "label": "Selected by default", "default": false } ] },
    { "type": "trust_pill", "name": "Trust pill", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "options": [ { "value": "check", "label": "Check" }, { "value": "shield", "label": "Shield" }, { "value": "truck", "label": "Truck" }, { "value": "leaf", "label": "Leaf" }, { "value": "star", "label": "Star" }, { "value": "clock", "label": "Clock" }, { "value": "drop", "label": "Drop" }, { "value": "emoji", "label": "Emoji" } ], "default": "check" },
      { "type": "text", "id": "emoji", "label": "Emoji (if Emoji icon)" },
      { "type": "text", "id": "text", "label": "Text" } ] },
    { "type": "accordion", "name": "Accordion item", "settings": [
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "richtext", "id": "content", "label": "Content" },
      { "type": "checkbox", "id": "open", "label": "Open by default", "default": false } ] }
  ],
  "presets": [ { "name": "LP · Product hero", "blocks": [ { "type": "rating" }, { "type": "title" }, { "type": "text" }, { "type": "bullet" }, { "type": "bullet" }, { "type": "bullet" }, { "type": "plan_card" }, { "type": "plan_card" }, { "type": "plan_card" }, { "type": "trust_pill" }, { "type": "trust_pill" }, { "type": "trust_pill" }, { "type": "trust_pill" }, { "type": "accordion" }, { "type": "accordion" } ] } ],
  "enabled_on": { "templates": [ "product" ] }
}
{% endschema %}
