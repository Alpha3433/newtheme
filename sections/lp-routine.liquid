{%- render 'lp-tokens' -%}
{%- assign s = section.settings -%}
<section class="lp lp-routine" id="lp-routine-{{ section.id }}">
  <div class="lp-routine__head">
    {%- if s.pill != blank -%}<div class="lp-pill"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><polyline points="8 12 11 15 16 9"/></svg>{{ s.pill | escape }}</div>{%- endif -%}
    {%- if s.heading != blank -%}<h2 class="lp-routine__h">{{ s.heading | escape }}</h2>{%- endif -%}
    {%- if s.subheading != blank -%}<div class="lp-routine__sub">{{ s.subheading }}</div>{%- endif -%}
  </div>
  <div class="lp-routine__grid lp-routine__grid--{{ s.columns | default: 'auto' }}">
    {%- assign step_open = false -%}
    {%- assign ings_open = false -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'step' -%}
        {%- if ings_open -%}</div>{%- assign ings_open = false -%}{%- endif -%}
        {%- if step_open -%}</div>{%- endif -%}
        {%- assign step_open = true -%}
        <div class="lp-routine__step" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank or block.settings.use_product_image -%}
            <div class="lp-routine__img-wrap">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 900 | image_tag: class: 'lp-routine__img', loading: 'lazy', alt: block.settings.image.alt }}
              {%- elsif product.featured_image != blank -%}
                {{ product.featured_image | image_url: width: 900 | image_tag: class: 'lp-routine__img', loading: 'lazy', alt: product.title }}
              {%- endif -%}
            </div>
          {%- endif -%}
          {%- if block.settings.tag != blank -%}<span class="lp-routine__step-tag">{{ block.settings.tag | escape }}</span>{%- endif -%}
          {%- if block.settings.title != blank -%}<h3 class="lp-routine__step-h">{{ block.settings.title | escape }}</h3>{%- endif -%}
          {%- if block.settings.text != blank -%}<div class="lp-routine__step-sub">{{ block.settings.text }}</div>{%- endif -%}
          {%- if block.settings.apply != blank -%}
            <div class="lp-routine__apply"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15 14"/></svg>{{ block.settings.apply | escape }}</div>
          {%- endif -%}
      {%- elsif block.type == 'ingredient' -%}
        {%- unless step_open -%}
          {%- assign step_open = true -%}
          <div class="lp-routine__step">
        {%- endunless -%}
        {%- unless ings_open -%}
          {%- assign ings_open = true -%}
          <div class="lp-routine__ings">
        {%- endunless -%}
        <div class="lp-routine__ing{% if block.settings.open %} open{% endif %}" data-lp-ing {{ block.shopify_attributes }}>
          <button type="button" class="lp-routine__ing-q" aria-expanded="{{ block.settings.open }}" data-lp-ing-q>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 80 | image_tag: class: 'lp-routine__ing-img', loading: 'lazy', alt: '' }}
            {%- else -%}
              <span class="lp-routine__ing-img lp-routine__ing-img--empty" aria-hidden="true"></span>
            {%- endif -%}
            <span class="lp-routine__ing-name">{{ block.settings.name | escape }}</span>
            <span class="lp-routine__ing-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></span>
          </button>
          <div class="lp-routine__ing-a">{{ block.settings.text }}</div>
        </div>
      {%- endif -%}
    {%- endfor -%}
    {%- if ings_open -%}</div>{%- endif -%}
    {%- if step_open -%}</div>{%- endif -%}
  </div>
</section>
{% style %}
  #lp-routine-{{ section.id }} { background: var(--lp-bg-warm); padding: 48px 16px 56px; border-top: 1px solid var(--lp-line); }
  #lp-routine-{{ section.id }} .lp-routine__head { max-width: 680px; margin: 0 auto 28px; text-align: center; }
  #lp-routine-{{ section.id }} .lp-routine__h { font-size: 24px; font-weight: 800; color: var(--lp-ink); letter-spacing: -.02em; line-height: 1.25; margin: 0 0 14px; text-wrap: balance; text-transform: none; }
  #lp-routine-{{ section.id }} .lp-routine__sub { font-size: 14.5px; color: var(--lp-ink-2); line-height: 1.65; }
  #lp-routine-{{ section.id }} .lp-routine__sub strong { font-weight: 700; color: var(--lp-ink); }
  #lp-routine-{{ section.id }} .lp-routine__grid { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 1fr; gap: 18px; }
  #lp-routine-{{ section.id }} .lp-routine__step { background: #fff; border: 1px solid var(--lp-line); border-radius: 16px; padding: 24px 22px; display: flex; flex-direction: column; gap: 14px; box-shadow: 0 6px 20px rgba(var(--lp-ink-rgb), .05); }
  #lp-routine-{{ section.id }} .lp-routine__img-wrap { width: 100%; background: linear-gradient(160deg, var(--lp-tint-4) 0%, var(--lp-tint-1) 100%); border-radius: 12px; overflow: hidden; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; margin: -4px 0 4px; }
  #lp-routine-{{ section.id }} .lp-routine__img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #lp-routine-{{ section.id }} .lp-routine__step-tag { display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; background: rgba(var(--lp-accent-rgb), .10); border: 1px solid rgba(var(--lp-accent-rgb), .30); border-radius: 999px; color: var(--lp-accent-dark); font-size: 10.5px; font-weight: 800; letter-spacing: 1.4px; text-transform: uppercase; line-height: 1; align-self: flex-start; }
  #lp-routine-{{ section.id }} .lp-routine__step-h { font-size: 18px; font-weight: 800; color: var(--lp-ink); letter-spacing: -.015em; line-height: 1.25; margin: 0; text-transform: none; }
  #lp-routine-{{ section.id }} .lp-routine__step-sub { font-size: 13.5px; color: var(--lp-ink-2); line-height: 1.6; }
  #lp-routine-{{ section.id }} .lp-routine__step-sub strong { font-weight: 700; color: var(--lp-ink); }
  #lp-routine-{{ section.id }} .lp-routine__apply { display: flex; align-items: center; gap: 9px; padding: 10px 14px; background: var(--lp-tint-4); border: 1px solid var(--lp-tint-1); border-radius: 8px; font-size: 12.5px; font-weight: 600; color: var(--lp-ink); line-height: 1.4; }
  #lp-routine-{{ section.id }} .lp-routine__apply svg { width: 15px; height: 15px; color: var(--lp-accent-dark); flex-shrink: 0; display: block; }
  #lp-routine-{{ section.id }} .lp-routine__ings { display: flex; flex-direction: column; border-top: 1px solid var(--lp-line); margin-top: 6px; }
  #lp-routine-{{ section.id }} .lp-routine__ing { border-bottom: 1px solid var(--lp-line); }
  #lp-routine-{{ section.id }} .lp-routine__ing:last-child { border-bottom: 0; }
  #lp-routine-{{ section.id }} .lp-routine__ing-q { display: flex; align-items: center; gap: 12px; width: 100%; padding: 12px 4px; background: transparent; border: 0; cursor: pointer; text-align: left; color: var(--lp-ink); }
  #lp-routine-{{ section.id }} .lp-routine__ing-img { flex-shrink: 0; width: 34px; height: 34px; border-radius: 50%; object-fit: cover; background: var(--lp-tint-3); border: 1.5px solid #fff; box-shadow: 0 2px 6px rgba(var(--lp-ink-rgb), .08); display: block; }
  #lp-routine-{{ section.id }} .lp-routine__ing-name { font-size: 14px; font-weight: 700; color: var(--lp-ink); line-height: 1.3; flex: 1; }
  #lp-routine-{{ section.id }} .lp-routine__ing-icon { flex-shrink: 0; width: 28px; height: 28px; border-radius: 50%; border: 1.5px solid var(--lp-tint-line); color: var(--lp-accent-dark); display: flex; align-items: center; justify-content: center; transition: transform .25s ease, background .25s ease; }
  #lp-routine-{{ section.id }} .lp-routine__ing-icon svg { width: 11px; height: 11px; display: block; }
  #lp-routine-{{ section.id }} .lp-routine__ing.open .lp-routine__ing-icon { transform: rotate(45deg); background: var(--lp-tint-3); }
  #lp-routine-{{ section.id }} .lp-routine__ing-a { display: none; padding: 0 4px 16px 50px; font-size: 13px; color: var(--lp-ink-2); line-height: 1.6; }
  #lp-routine-{{ section.id }} .lp-routine__ing-a p { margin: 0 0 8px; } #lp-routine-{{ section.id }} .lp-routine__ing-a p:last-child { margin: 0; }
  #lp-routine-{{ section.id }} .lp-routine__ing-a strong { font-weight: 700; color: var(--lp-ink); }
  #lp-routine-{{ section.id }} .lp-routine__ing.open .lp-routine__ing-a { display: block; }
  @media (min-width: 640px) { #lp-routine-{{ section.id }} { padding: 56px 16px 64px; } #lp-routine-{{ section.id }} .lp-routine__h { font-size: 28px; } }
  @media (min-width: 980px) {
    #lp-routine-{{ section.id }} { padding: 64px 24px 72px; }
    #lp-routine-{{ section.id }} .lp-routine__h { font-size: 32px; }
    #lp-routine-{{ section.id }} .lp-routine__sub { font-size: 15.5px; }
    #lp-routine-{{ section.id }} .lp-routine__grid--auto { grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px; align-items: start; max-width: {{ s.max_width | default: 1200 }}px; }
    #lp-routine-{{ section.id }} .lp-routine__grid--one { max-width: 720px; }
    #lp-routine-{{ section.id }} .lp-routine__grid--two { grid-template-columns: 1fr 1fr; gap: 24px; align-items: start; }
    #lp-routine-{{ section.id }} .lp-routine__step { padding: 28px 26px; }
    #lp-routine-{{ section.id }} .lp-routine__step-h { font-size: 20px; }
  }
{% endstyle %}
<script>
(function () {
  var root = document.getElementById('lp-routine-{{ section.id }}');
  if (!root || root.dataset.lpInit) return; root.dataset.lpInit = '1';
  root.querySelectorAll('[data-lp-ing-q]').forEach(function (q) {
    q.addEventListener('click', function () { var i = q.closest('[data-lp-ing]'); var o = i.classList.toggle('open'); q.setAttribute('aria-expanded', o ? 'true' : 'false'); });
  });
})();
</script>
{% schema %}
{
  "name": "LP · Routine / what's inside",
  "tag": "section",
  "class": "lp-section",
  "settings": [
    { "type": "text", "id": "pill", "label": "Pill", "default": "What's in your order" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One Serum. 60 Seconds. Nightly." },
    { "type": "richtext", "id": "subheading", "label": "Subheading" },
    { "type": "select", "id": "columns", "label": "Desktop layout", "options": [ { "value": "auto", "label": "Auto (fit cards)" }, { "value": "one", "label": "Single column" }, { "value": "two", "label": "Two columns" } ], "default": "auto" },
    { "type": "range", "id": "max_width", "min": 720, "max": 1400, "step": 20, "unit": "px", "label": "Max width", "default": 1200 }
  ],
  "blocks": [
    { "type": "step", "name": "Step card", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "checkbox", "id": "use_product_image", "label": "Use product image if empty", "default": true },
      { "type": "text", "id": "tag", "label": "Tag", "default": "Step 1" },
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "richtext", "id": "text", "label": "Text" },
      { "type": "text", "id": "apply", "label": "Apply note", "info": "Shown in a small box with a clock icon" } ] },
    { "type": "ingredient", "name": "Ingredient row (belongs to the step above)", "settings": [
      { "type": "image_picker", "id": "image", "label": "Icon image" },
      { "type": "text", "id": "name", "label": "Name" },
      { "type": "richtext", "id": "text", "label": "Text" },
      { "type": "checkbox", "id": "open", "label": "Open by default", "default": false } ] }
  ],
  "presets": [ { "name": "LP · Routine / what's inside", "blocks": [ { "type": "step" }, { "type": "ingredient" }, { "type": "ingredient" } ] } ]
}
{% endschema %}
