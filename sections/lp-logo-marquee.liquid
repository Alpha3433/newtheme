{%- render 'lp-tokens' -%}
{%- if section.blocks.size > 0 -%}
<section class="lp lp-pr" id="lp-pr-{{ section.id }}">
  {%- if section.settings.label != blank -%}<div class="lp-pr__label">{{ section.settings.label | escape }}</div>{%- endif -%}
  <div class="lp-pr__mask">
    <div class="lp-pr__track" style="animation-duration: {{ section.settings.speed | default: 38 }}s;">
      {%- for i in (1..2) -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.image != blank -%}
            <div class="lp-pr__item" {% if i == 1 %}{{ block.shopify_attributes }}{% else %}aria-hidden="true"{% endif %}>
              {{ block.settings.image | image_url: width: 400 | image_tag: class: 'lp-pr__img', loading: 'lazy', alt: block.settings.alt }}
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{% style %}
  #lp-pr-{{ section.id }} { background: var(--lp-band-soft); padding: 22px 0 24px; overflow: hidden; border-top: 1px solid var(--lp-tint-line); border-bottom: 1px solid var(--lp-tint-line); }
  #lp-pr-{{ section.id }} .lp-pr__label { text-align: center; font-size: 10.5px; font-weight: 800; letter-spacing: 1.8px; text-transform: uppercase; color: var(--lp-ink); opacity: .6; margin: 0 0 16px; padding: 0 16px; line-height: 1; }
  #lp-pr-{{ section.id }} .lp-pr__mask { position: relative; width: 100%; overflow: hidden; mask-image: linear-gradient(90deg, transparent 0, #000 8%, #000 92%, transparent 100%); -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 8%, #000 92%, transparent 100%); }
  #lp-pr-{{ section.id }} .lp-pr__track { display: flex; gap: 18px; width: max-content; animation: lp-pr-scroll 38s linear infinite; will-change: transform; padding: 0 9px; }
  #lp-pr-{{ section.id }}:hover .lp-pr__track { animation-play-state: paused; }
  #lp-pr-{{ section.id }} .lp-pr__item { flex-shrink: 0; width: {{ section.settings.logo_height | default: 44 | times: 3.2 | round }}px; height: {{ section.settings.logo_height | default: 44 | times: 1.6 | round }}px; border-radius: 12px; background: #fff; display: flex; align-items: center; justify-content: center; padding: 10px 16px; box-shadow: 0 2px 8px rgba(var(--lp-ink-rgb), .06); }
  #lp-pr-{{ section.id }} .lp-pr__img { max-height: {{ section.settings.logo_height | default: 44 }}px; width: auto; max-width: 100%; object-fit: contain; display: block; {% if section.settings.grayscale %}filter: grayscale(100%); opacity: .8;{% endif %} }
  @keyframes lp-pr-scroll { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
  @media (min-width: 640px) { #lp-pr-{{ section.id }} { padding: 28px 0 30px; } }
  @media (min-width: 980px) { #lp-pr-{{ section.id }} { padding: 32px 0 34px; } #lp-pr-{{ section.id }} .lp-pr__track { gap: 22px; } }
  @media (prefers-reduced-motion: reduce) { #lp-pr-{{ section.id }} .lp-pr__track { animation: none; flex-wrap: wrap; justify-content: center; width: 100%; } }
{% endstyle %}
{%- endif -%}
{% schema %}
{
  "name": "LP · Logo marquee",
  "tag": "section",
  "class": "lp-section",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "As Seen In" },
    { "type": "range", "id": "logo_height", "min": 24, "max": 120, "step": 4, "unit": "px", "label": "Logo height", "default": 44 },
    { "type": "range", "id": "speed", "min": 10, "max": 90, "step": 2, "unit": "s", "label": "Scroll duration", "default": 38 },
    { "type": "checkbox", "id": "grayscale", "label": "Grayscale logos", "default": false }
  ],
  "blocks": [
    { "type": "logo", "name": "Logo", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "alt", "label": "Alt text" } ] }
  ],
  "presets": [ { "name": "LP · Logo marquee", "blocks": [ { "type": "logo" }, { "type": "logo" }, { "type": "logo" } ] } ]
}
{% endschema %}
