{%- render 'lp-tokens' -%}
{%- assign s = section.settings -%}
<section class="lp lp-guar" id="lp-guar-{{ section.id }}">
  <div class="lp-guar__inner">
    {%- if s.badge != blank -%}
      {{ s.badge | image_url: width: 400 | image_tag: class: 'lp-guar__badge', loading: 'lazy', alt: s.badge.alt }}
    {%- else -%}
      <span class="lp-guar__badge lp-guar__badge--svg" aria-hidden="true">
        <svg viewBox="0 0 120 120"><circle cx="60" cy="60" r="56" fill="var(--lp-accent)"/><circle cx="60" cy="60" r="46" fill="none" stroke="#fff" stroke-width="2.5" stroke-dasharray="4 4"/><text x="60" y="52" text-anchor="middle" font-family="inherit" font-weight="800" font-size="26" fill="#fff">{{ s.badge_number | default: '90' | escape }}</text><text x="60" y="70" text-anchor="middle" font-weight="800" font-size="11" letter-spacing="2" fill="#fff">{{ s.badge_word | default: 'DAY' | escape }}</text><path d="M42 84l10 9 26-24" fill="none" stroke="#fff" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
    {%- endif -%}
    <div class="lp-guar__content">
      {%- if s.heading != blank -%}<h2 class="lp-guar__h">{{ s.heading | escape }}</h2>{%- endif -%}
      <div class="lp-guar__body">{{ s.body }}</div>
    </div>
  </div>
</section>
{% style %}
  #lp-guar-{{ section.id }} { width: 100%; background: var(--lp-band); border-top: 1px solid var(--lp-tint-line); border-bottom: 1px solid var(--lp-tint-line); padding: 40px 20px; overflow: hidden; }
  #lp-guar-{{ section.id }} .lp-guar__inner { max-width: 900px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 24px; text-align: center; }
  #lp-guar-{{ section.id }} .lp-guar__badge { flex-shrink: 0; width: 130px; height: 130px; display: block; object-fit: contain; filter: drop-shadow(0 6px 18px rgba(var(--lp-ink-rgb), .18)); }
  #lp-guar-{{ section.id }} .lp-guar__badge svg { width: 100%; height: 100%; display: block; }
  #lp-guar-{{ section.id }} .lp-guar__content { flex: 1; }
  #lp-guar-{{ section.id }} .lp-guar__h { font-size: 22px; font-weight: 800; color: var(--lp-ink); letter-spacing: -.02em; line-height: 1.25; margin: 0 0 12px; text-wrap: balance; text-transform: none; }
  #lp-guar-{{ section.id }} .lp-guar__body { font-size: 14px; color: var(--lp-ink-2); line-height: 1.65; }
  #lp-guar-{{ section.id }} .lp-guar__body p { margin: 0 0 8px; } #lp-guar-{{ section.id }} .lp-guar__body p:last-child { margin: 0; }
  #lp-guar-{{ section.id }} .lp-guar__body strong { font-weight: 700; color: var(--lp-ink); }
  @media (min-width: 640px) {
    #lp-guar-{{ section.id }} { padding: 48px 24px; }
    #lp-guar-{{ section.id }} .lp-guar__inner { flex-direction: row; text-align: left; gap: 36px; align-items: center; }
    #lp-guar-{{ section.id }} .lp-guar__badge { width: 160px; height: 160px; }
    #lp-guar-{{ section.id }} .lp-guar__h { font-size: 26px; }
    #lp-guar-{{ section.id }} .lp-guar__body { font-size: 15px; }
  }
  @media (min-width: 980px) {
    #lp-guar-{{ section.id }} { padding: 56px 24px; }
    #lp-guar-{{ section.id }} .lp-guar__inner { gap: 48px; }
    #lp-guar-{{ section.id }} .lp-guar__badge { width: 180px; height: 180px; }
    #lp-guar-{{ section.id }} .lp-guar__h { font-size: 30px; }
    #lp-guar-{{ section.id }} .lp-guar__body { font-size: 15.5px; }
  }
{% endstyle %}
{% schema %}
{
  "name": "LP · Guarantee band",
  "tag": "section",
  "class": "lp-section",
  "settings": [
    { "type": "image_picker", "id": "badge", "label": "Badge image", "info": "Blank shows a built-in '90 DAY' seal in the accent colour" },
    { "type": "text", "id": "badge_number", "label": "Built-in seal number", "default": "90" },
    { "type": "text", "id": "badge_word", "label": "Built-in seal word", "default": "DAY" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Visible Results In 90 Days Or Your Money Back" },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Apply it nightly for 90 days. If you're not seeing fuller hair by day 90, email us for a full refund — <strong>no return needed</strong>.</p>" }
  ],
  "presets": [ { "name": "LP · Guarantee band" } ]
}
{% endschema %}
