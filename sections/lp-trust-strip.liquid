{%- render 'lp-tokens' -%}
{%- if section.blocks.size > 0 -%}
<section class="lp lp-trust-strip" id="lp-trust-{{ section.id }}">
  <div class="lp-trust-strip__inner">
    {%- for block in section.blocks -%}
      {%- unless forloop.first -%}<span class="lp-trust-strip__sep" aria-hidden="true"></span>{%- endunless -%}
      <span class="lp-trust-strip__item" {{ block.shopify_attributes }}>
        {%- if block.type == 'rating' -%}
          <span class="lp-trust-strip__num">{{ block.settings.rating | escape }}</span>
          <span class="lp-trust-strip__stars" aria-hidden="true">★★★★★</span>
          <span class="lp-trust-strip__muted">{{ block.settings.count | escape }}</span>
        {%- else -%}
          {%- case block.settings.icon -%}
            {%- when 'check' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><polyline points="8 12 11 15 16 9"/></svg>
            {%- when 'shield' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
            {%- when 'leaf' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 20c0-8 5-14 15-15-1 10-7 15-15 15z"/><path d="M5 20l9-9"/></svg>
            {%- when 'user' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>
            {%- when 'truck' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/></svg>
            {%- when 'ban' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M6 6l12 12"/></svg>
            {%- when 'drop' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11z"/></svg>
          {%- endcase -%}
          {{ block.settings.text | escape }}
        {%- endif -%}
      </span>
    {%- endfor -%}
  </div>
</section>
{% style %}
  #lp-trust-{{ section.id }} { background: var(--lp-band); border-top: 1px solid var(--lp-tint-line); border-bottom: 1px solid var(--lp-tint-line); padding: 14px 16px; width: 100%; }
  #lp-trust-{{ section.id }} .lp-trust-strip__inner { max-width: 1200px; margin: 0 auto; display: flex; align-items: center; justify-content: center; gap: 14px; flex-wrap: wrap; text-align: center; }
  #lp-trust-{{ section.id }} .lp-trust-strip__item { display: inline-flex; align-items: center; gap: 8px; font-size: 10.5px; font-weight: 800; letter-spacing: 1.5px; text-transform: uppercase; color: var(--lp-ink); line-height: 1; }
  #lp-trust-{{ section.id }} .lp-trust-strip__item svg { width: 16px; height: 16px; color: var(--lp-accent-dark); flex-shrink: 0; display: block; }
  #lp-trust-{{ section.id }} .lp-trust-strip__sep { display: none; width: 3px; height: 3px; border-radius: 50%; background: rgba(var(--lp-ink-rgb), .25); flex-shrink: 0; }
  #lp-trust-{{ section.id }} .lp-trust-strip__stars { display: inline-flex; align-items: center; color: var(--lp-star); font-size: 13px; letter-spacing: 1.2px; line-height: 1; margin-right: 2px; }
  #lp-trust-{{ section.id }} .lp-trust-strip__num { font-weight: 800; margin-right: 2px; }
  #lp-trust-{{ section.id }} .lp-trust-strip__muted { color: var(--lp-muted); font-weight: 600; letter-spacing: 1px; }
  @media (min-width: 560px) {
    #lp-trust-{{ section.id }} { padding: 16px 20px; }
    #lp-trust-{{ section.id }} .lp-trust-strip__inner { gap: 22px; }
    #lp-trust-{{ section.id }} .lp-trust-strip__sep { display: inline-block; }
    #lp-trust-{{ section.id }} .lp-trust-strip__item { font-size: 11px; }
    #lp-trust-{{ section.id }} .lp-trust-strip__item svg { width: 18px; height: 18px; }
  }
  @media (min-width: 980px) {
    #lp-trust-{{ section.id }} .lp-trust-strip__inner { gap: 32px; }
    #lp-trust-{{ section.id }} .lp-trust-strip__item { font-size: 12px; letter-spacing: 1.7px; }
    #lp-trust-{{ section.id }} .lp-trust-strip__item svg { width: 20px; height: 20px; }
  }
{% endstyle %}
{%- endif -%}
{% schema %}
{
  "name": "LP · Trust strip",
  "tag": "section",
  "class": "lp-section",
  "settings": [],
  "blocks": [
    { "type": "item", "name": "Item", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "options": [ { "value": "check", "label": "Check" }, { "value": "shield", "label": "Shield" }, { "value": "leaf", "label": "Leaf" }, { "value": "user", "label": "Person" }, { "value": "truck", "label": "Truck" }, { "value": "ban", "label": "No / ban" }, { "value": "drop", "label": "Drop" }, { "value": "none", "label": "None" } ], "default": "check" },
      { "type": "text", "id": "text", "label": "Text", "default": "90-Day Guarantee" } ] },
    { "type": "rating", "name": "Rating", "limit": 1, "settings": [
      { "type": "text", "id": "rating", "label": "Rating", "default": "4.8" },
      { "type": "text", "id": "count", "label": "Count text", "default": "43 Reviews" } ] }
  ],
  "presets": [ { "name": "LP · Trust strip", "blocks": [ { "type": "item" }, { "type": "item" }, { "type": "item" }, { "type": "item" } ] } ]
}
{% endschema %}
