{%- render 'lp-tokens' -%}
{%- liquid
  assign s = section.settings
  assign stats = section.blocks | where: 'type', 'stat'
-%}
{%- if stats.size > 0 -%}
<section class="lp lp-study" id="lp-study-{{ section.id }}" data-lp-study>
  <div class="lp-study__grid">
    <div class="lp-study__imgs" data-lp-study-imgs>
      {%- for block in stats -%}
        <figure class="lp-study__img-card{% if forloop.first %} is-active{% endif %}" data-lp-study-img="{{ forloop.index0 }}">
          {%- if block.settings.before_image != blank or block.settings.after_image != blank -%}
            <div class="lp-study__pair">
              <div class="lp-study__pair-cell">
                {%- if block.settings.before_image != blank -%}{{ block.settings.before_image | image_url: width: 700 | image_tag: class: 'lp-study__pair-pic', loading: 'lazy', alt: block.settings.before_label }}{%- endif -%}
                <span class="lp-study__pair-label">{{ block.settings.before_label | default: 'Before' | escape }}</span>
              </div>
              <div class="lp-study__pair-cell">
                {%- if block.settings.after_image != blank -%}{{ block.settings.after_image | image_url: width: 700 | image_tag: class: 'lp-study__pair-pic', loading: 'lazy', alt: block.settings.after_label }}{%- endif -%}
                <span class="lp-study__pair-label">{{ block.settings.after_label | default: 'After' | escape }}</span>
              </div>
            </div>
          {%- elsif block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 900 | image_tag: class: 'lp-study__img-pic', loading: 'lazy', alt: block.settings.label }}
          {%- endif -%}
          {%- if block.settings.caption != blank -%}<figcaption class="lp-study__img-cap">{{ block.settings.caption | escape }}</figcaption>{%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
    <div class="lp-study__content">
      {%- if s.pill != blank -%}<span class="lp-pill">{{ s.pill | escape }}</span>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="lp-study__h">{{ s.heading | escape }}</h2>{%- endif -%}
      {%- if s.subheading != blank -%}<div class="lp-study__subhead">{{ s.subheading }}</div>{%- endif -%}
      {%- if s.cue != blank -%}<p class="lp-study__cue">{{ s.cue | escape }} <span class="lp-study__cue-arrow" aria-hidden="true">→</span></p>{%- endif -%}
      <div class="lp-study__stats">
        {%- for block in stats -%}
          <div class="lp-study__stat{% if forloop.first %} is-active{% endif %}" data-lp-stat="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            <button type="button" class="lp-study__stat-btn" data-lp-stat-btn aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}">
              <div class="lp-study__bar-row">
                <div class="lp-study__bar" style="--lp-bar: {{ block.settings.width | default: 100 }}%;"><span class="lp-study__bar-num">{{ block.settings.num | escape }}</span></div>
                <span class="lp-study__chev" aria-hidden="true"></span>
              </div>
              {%- if block.settings.label != blank -%}<div class="lp-study__stat-label">{{ block.settings.label | escape }}</div>{%- endif -%}
            </button>
            <div class="lp-study__stat-content">
              {%- if block.settings.body != blank -%}<div class="lp-study__stat-body">{{ block.settings.body }}</div>{%- endif -%}
              {%- if block.settings.before_image != blank or block.settings.after_image != blank -%}
                <figure class="lp-study__stat-img">
                  <div class="lp-study__pair lp-study__pair--inline">
                    <div class="lp-study__pair-cell">{%- if block.settings.before_image != blank -%}{{ block.settings.before_image | image_url: width: 500 | image_tag: class: 'lp-study__pair-pic', loading: 'lazy', alt: block.settings.before_label }}{%- endif -%}<span class="lp-study__pair-label">{{ block.settings.before_label | default: 'Before' | escape }}</span></div>
                    <div class="lp-study__pair-cell">{%- if block.settings.after_image != blank -%}{{ block.settings.after_image | image_url: width: 500 | image_tag: class: 'lp-study__pair-pic', loading: 'lazy', alt: block.settings.after_label }}{%- endif -%}<span class="lp-study__pair-label">{{ block.settings.after_label | default: 'After' | escape }}</span></div>
                  </div>
                  {%- if block.settings.caption != blank -%}<figcaption>{{ block.settings.caption | escape }}</figcaption>{%- endif -%}
                </figure>
              {%- elsif block.settings.image != blank -%}
                <figure class="lp-study__stat-img">{{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', alt: block.settings.label }}{%- if block.settings.caption != blank -%}<figcaption>{{ block.settings.caption | escape }}</figcaption>{%- endif -%}</figure>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
      {%- if s.disclaimer != blank -%}<p class="lp-study__disc">{{ s.disclaimer | escape }}</p>{%- endif -%}
    </div>
  </div>
</section>
{% style %}
  #lp-study-{{ section.id }} { padding: 48px 16px 56px; background: var(--lp-bg-warm); border-top: 1px solid var(--lp-line); }
  #lp-study-{{ section.id }} .lp-study__grid { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 1fr; gap: 28px; align-items: start; }
  #lp-study-{{ section.id }} .lp-study__content { display: flex; flex-direction: column; }
  #lp-study-{{ section.id }} .lp-pill { align-self: flex-start; }
  #lp-study-{{ section.id }} .lp-study__h { font-size: 26px; font-weight: 800; color: var(--lp-ink); letter-spacing: -.025em; line-height: 1.2; margin: 0 0 18px; text-wrap: balance; text-transform: none; }
  #lp-study-{{ section.id }} .lp-study__subhead { font-size: 14.5px; color: var(--lp-ink-2); line-height: 1.65; margin: 0 0 24px; padding: 0 0 22px; border-bottom: 1px solid var(--lp-line); }
  #lp-study-{{ section.id }} .lp-study__subhead strong { font-weight: 700; color: var(--lp-ink); }
  #lp-study-{{ section.id }} .lp-study__cue { display: flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 600; color: var(--lp-muted); font-style: italic; margin: 0 0 14px; line-height: 1.3; }
  #lp-study-{{ section.id }} .lp-study__cue-arrow { color: var(--lp-accent-dark); font-style: normal; font-weight: 800; font-size: 13px; }
  #lp-study-{{ section.id }} .lp-study__stats { display: flex; flex-direction: column; gap: 8px; }
  #lp-study-{{ section.id }} .lp-study__stat { position: relative; background: #fff; border: 1px solid var(--lp-line); border-radius: 14px; overflow: hidden; transition: border-color .2s ease, background .2s ease, box-shadow .2s ease; }
  #lp-study-{{ section.id }} .lp-study__stat.is-active { border-color: var(--lp-accent); background: var(--lp-tint-4); box-shadow: 0 4px 14px rgba(var(--lp-accent-rgb), .10); }
  #lp-study-{{ section.id }} .lp-study__stat-btn { appearance: none; background: transparent; border: 0; padding: 14px 16px 12px; width: 100%; cursor: pointer; text-align: left; color: inherit; display: block; }
  #lp-study-{{ section.id }} .lp-study__bar-row { display: flex; align-items: center; gap: 10px; }
  #lp-study-{{ section.id }} .lp-study__bar { position: relative; flex: 1; height: 42px; border-radius: 999px; background: var(--lp-tint-3); overflow: hidden; display: flex; align-items: center; padding: 0 22px; }
  #lp-study-{{ section.id }} .lp-study__bar::before { content: ""; position: absolute; top: 0; left: 0; bottom: 0; width: var(--lp-bar, 100%); background: linear-gradient(90deg, var(--lp-ink) 0%, var(--lp-accent) 60%, var(--lp-accent-2) 100%); border-radius: 999px; z-index: 1; }
  #lp-study-{{ section.id }} .lp-study__bar-num { position: relative; z-index: 2; font-size: 21px; font-weight: 800; color: #fff; letter-spacing: -.02em; line-height: 1; text-shadow: 0 1px 2px rgba(var(--lp-ink-rgb), .18); white-space: nowrap; }
  #lp-study-{{ section.id }} .lp-study__chev { flex-shrink: 0; width: 26px; height: 26px; border-radius: 50%; background: #fff; border: 1.5px solid var(--lp-tint-line); color: var(--lp-accent-dark); display: flex; align-items: center; justify-content: center; transition: transform .25s ease, background .25s ease, color .25s ease; }
  #lp-study-{{ section.id }} .lp-study__chev::before { content: "+"; font-size: 16px; font-weight: 800; line-height: 1; }
  #lp-study-{{ section.id }} .lp-study__stat.is-active .lp-study__chev { background: var(--lp-accent); border-color: var(--lp-accent); color: #fff; transform: rotate(45deg); }
  #lp-study-{{ section.id }} .lp-study__stat-label { font-size: 12px; font-weight: 800; color: var(--lp-accent-dark); letter-spacing: 1.6px; text-transform: uppercase; margin: 12px 0 0; line-height: 1.1; }
  #lp-study-{{ section.id }} .lp-study__stat-content { display: none; padding: 0 16px 16px; }
  #lp-study-{{ section.id }} .lp-study__stat.is-active .lp-study__stat-content { display: block; }
  #lp-study-{{ section.id }} .lp-study__stat-body { font-size: 13.5px; color: var(--lp-ink-2); line-height: 1.6; margin: 6px 0 0; }
  #lp-study-{{ section.id }} .lp-study__stat-body p { margin: 0 0 8px; } #lp-study-{{ section.id }} .lp-study__stat-body p:last-child { margin: 0; }
  #lp-study-{{ section.id }} .lp-study__stat-body strong { font-weight: 700; color: var(--lp-ink); }
  #lp-study-{{ section.id }} .lp-study__stat-img { margin: 14px 0 0; }
  #lp-study-{{ section.id }} .lp-study__stat-img > img { width: 100%; aspect-ratio: 1/1; object-fit: cover; border-radius: 12px; border: 1px solid var(--lp-tint-line); display: block; }
  #lp-study-{{ section.id }} .lp-study__stat-img figcaption, #lp-study-{{ section.id }} .lp-study__img-cap { font-size: 12px; color: var(--lp-muted); text-align: center; margin: 8px 0 0; font-style: italic; line-height: 1.4; }
  #lp-study-{{ section.id }} .lp-study__pair { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  #lp-study-{{ section.id }} .lp-study__pair-cell { display: flex; flex-direction: column; gap: 8px; }
  #lp-study-{{ section.id }} .lp-study__pair-pic { width: 100%; aspect-ratio: {{ s.ratio | default: '1/1' }}; object-fit: cover; display: block; border-radius: 12px; border: 1px solid var(--lp-tint-line); box-shadow: 0 6px 24px rgba(var(--lp-ink-rgb), .08); background: var(--lp-tint-4); }
  #lp-study-{{ section.id }} .lp-study__pair-label { font-size: 11px; font-weight: 700; letter-spacing: 1.4px; color: var(--lp-muted); text-transform: uppercase; text-align: center; }
  #lp-study-{{ section.id }} .lp-study__imgs { display: none; position: relative; width: 100%; }
  #lp-study-{{ section.id }} .lp-study__img-card { position: relative; width: 100%; margin: 0; opacity: 0; visibility: hidden; transition: opacity .35s ease; }
  #lp-study-{{ section.id }} .lp-study__img-card:not(:first-child) { position: absolute; top: 0; left: 0; }
  #lp-study-{{ section.id }} .lp-study__img-card.is-active { opacity: 1; visibility: visible; }
  #lp-study-{{ section.id }} .lp-study__img-pic { width: 100%; aspect-ratio: 1/1; object-fit: cover; display: block; border-radius: 14px; border: 1px solid var(--lp-tint-line); box-shadow: 0 6px 24px rgba(var(--lp-ink-rgb), .08); }
  #lp-study-{{ section.id }} .lp-study__img-cap { font-size: 13px; margin-top: 14px; }
  #lp-study-{{ section.id }} .lp-study__disc { font-size: 11px; font-weight: 500; color: var(--lp-faint); line-height: 1.55; margin: 28px 0 0; font-style: italic; padding-top: 20px; border-top: 1px solid var(--lp-line); }
  @media (min-width: 640px) { #lp-study-{{ section.id }} { padding: 56px 16px 64px; } #lp-study-{{ section.id }} .lp-study__h { font-size: 30px; } #lp-study-{{ section.id }} .lp-study__bar { height: 46px; } #lp-study-{{ section.id }} .lp-study__bar-num { font-size: 23px; } }
  @media (min-width: 980px) {
    #lp-study-{{ section.id }} { padding: 72px 24px 88px; }
    #lp-study-{{ section.id }} .lp-study__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 56px; }
    #lp-study-{{ section.id }} .lp-study__h { font-size: 36px; letter-spacing: -.03em; }
    #lp-study-{{ section.id }} .lp-study__bar { height: 50px; } #lp-study-{{ section.id }} .lp-study__bar-num { font-size: 25px; }
    #lp-study-{{ section.id }} .lp-study__imgs { display: block; position: sticky; top: 120px; }
    #lp-study-{{ section.id }} .lp-study__stat-content { display: block; padding: 0 16px 16px; }
    #lp-study-{{ section.id }} .lp-study__stat-img { display: none; }
    #lp-study-{{ section.id }} .lp-study__chev { width: 22px; height: 22px; }
    #lp-study-{{ section.id }} .lp-study__chev::before { content: ""; display: block; width: 8px; height: 8px; border-right: 2px solid currentColor; border-bottom: 2px solid currentColor; transform: rotate(-45deg) translate(-1px, -1px); }
    #lp-study-{{ section.id }} .lp-study__stat.is-active .lp-study__chev { transform: none; }
  }
{% endstyle %}
<script>
(function () {
  var root = document.getElementById('lp-study-{{ section.id }}');
  if (!root || root.dataset.lpInit) return; root.dataset.lpInit = '1';
  var stats = root.querySelectorAll('[data-lp-stat]'); var imgs = root.querySelectorAll('[data-lp-study-img]');
  stats.forEach(function (st) {
    st.querySelector('[data-lp-stat-btn]').addEventListener('click', function () {
      var i = st.dataset.lpStat; var already = st.classList.contains('is-active');
      var desktop = window.matchMedia('(min-width: 980px)').matches;
      stats.forEach(function (o) { var on = o === st && (desktop || !already); o.classList.toggle('is-active', on); o.querySelector('[data-lp-stat-btn]').setAttribute('aria-expanded', on ? 'true' : 'false'); });
      imgs.forEach(function (im) { im.classList.toggle('is-active', im.dataset.lpStudyImg === i); });
    });
  });
})();
</script>
{%- endif -%}
{% schema %}
{
  "name": "LP · Results timeline",
  "tag": "section",
  "class": "lp-section",
  "settings": [
    { "type": "text", "id": "pill", "label": "Pill", "default": "What to expect" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Less Shedding In 2 Weeks. Fuller In 90." },
    { "type": "richtext", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "cue", "label": "Cue line", "default": "Tap each milestone to see it" },
    { "type": "select", "id": "ratio", "label": "Image ratio", "options": [ { "value": "1/1", "label": "Square" }, { "value": "3/4", "label": "Portrait 3:4" } ], "default": "1/1" },
    { "type": "text", "id": "disclaimer", "label": "Disclaimer", "default": "Individual results vary." }
  ],
  "blocks": [
    { "type": "stat", "name": "Milestone / stat", "settings": [
      { "type": "text", "id": "num", "label": "Bar text", "default": "Weeks 1–2" },
      { "type": "range", "id": "width", "min": 10, "max": 100, "step": 5, "unit": "%", "label": "Bar fill", "default": 100 },
      { "type": "text", "id": "label", "label": "Label", "default": "Less shedding" },
      { "type": "richtext", "id": "body", "label": "Body" },
      { "type": "image_picker", "id": "before_image", "label": "Before image" },
      { "type": "text", "id": "before_label", "label": "Before label", "default": "Before" },
      { "type": "image_picker", "id": "after_image", "label": "After image" },
      { "type": "text", "id": "after_label", "label": "After label", "default": "After" },
      { "type": "image_picker", "id": "image", "label": "Single image (if no pair)" },
      { "type": "text", "id": "caption", "label": "Caption" } ] }
  ],
  "presets": [ { "name": "LP · Results timeline", "blocks": [ { "type": "stat" }, { "type": "stat" }, { "type": "stat" } ] } ]
}
{% endschema %}
